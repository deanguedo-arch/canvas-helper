                <material>
                  <mattext texttype="text/html">&lt;p&gt;a valuable tool that is always being revised.&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i6c718c2f-3939-4f67-aced-0011ffd46cdd">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;as tool that is being revised but has no real value.&lt;/p&gt;</mattext>
