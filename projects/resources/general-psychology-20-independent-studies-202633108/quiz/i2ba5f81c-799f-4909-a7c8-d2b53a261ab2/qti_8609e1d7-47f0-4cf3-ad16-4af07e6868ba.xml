        <presentation>
          <material>
            <mattext texttype="text/html">&lt;h3 class="question-text"&gt; Which is an example of the autonomy versus shame and doubt stage?&lt;/h3&gt;</mattext>
          </material>
          <response_lid ident="if645d2da-cb00-4cfa-bcab-3f2101f1e695" rcardinality="Single">
            <render_choice shuffle="Yes">
              <response_label ident="idc45835f-632c-4f15-bf84-1e8dc50e1244">
                <material>
                  <mattext texttype="text/html">&lt;div class="answer-text"&gt;A preschooler insisting on picking out her own clothes, no matter how mismatched they are&lt;/div&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="id705e70b-d591-4ed8-831b-adb51a83db1d">
                <material>
                  <mattext texttype="text/html">&lt;div class="answer-text"&gt;An infant chewing on a teething ring&lt;/div&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i4e39f051-ca10-46da-a5e5-2f0a553f5bb1">
                <material>
                  <mattext texttype="text/html">&lt;div class="answer-text"&gt;A middle-schooler completing a challenging math assignment&lt;/div&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i2ffa8d3c-3dff-455c-8d71-497e4d6795a8">
                <material>
                  <mattext texttype="text/html">&lt;div class="answer-text"&gt;A teenager trying out new fashions and hairstyles&lt;/div&gt;</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
