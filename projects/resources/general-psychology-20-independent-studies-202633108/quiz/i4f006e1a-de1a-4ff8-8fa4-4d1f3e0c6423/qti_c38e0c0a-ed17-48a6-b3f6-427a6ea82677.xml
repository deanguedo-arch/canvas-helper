              <response_label ident="ica97774d-a685-48cb-a6fa-a3b6cc265517">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;span&gt;Children's language development follows a similar pattern across cultures&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i9a4a71b9-b858-41b4-96a6-0dd131149bcc">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;span&gt;Children acquire language quickly and effortlessly&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i2e535373-7c3c-4718-864a-0b538a90eec2">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;span&gt;The stages of language development occur at about the same ages in most children&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="ie85571a1-2a5f-4b5d-b0de-c21098a28bf7">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;span&gt;All of the above&lt;/span&gt;&lt;/p&gt;</mattext>
