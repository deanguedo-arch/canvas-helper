              <response_label ident="i188bc83e-eb39-40a7-b8c4-5c57be61d636">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Conservation &lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i9169d884-05c2-4778-80ab-931e92b866dc">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;span&gt;Accommodation&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="icd820ea2-e04a-42d8-82a0-42224fb341d0">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;span&gt;Egocentrism&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
