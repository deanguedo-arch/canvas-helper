        <presentation>
          <material>
            <mattext texttype="text/html">&lt;p&gt;&lt;span&gt;Stressors are more likely to affect health if they are which of the following?&lt;/span&gt;&lt;/p&gt;</mattext>
          </material>
          <response_lid ident="i13d8d622-100c-4789-a72e-c7e78d5a2fd1" rcardinality="Single">
            <render_choice>
              <response_label ident="i1434e59e-ed72-4362-b15a-c5603ec8a826">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Highly disruptive&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="if941e52d-6694-4bea-97f9-0c58e30427b6">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;span&gt;Difficult to control&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i26a6c59e-d7ab-483a-ba4d-2ba506b3b8e4">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Long lasting&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="ie675e839-6272-493c-afbc-ecbb72916f7d">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;All of the above&lt;/p&gt;</mattext>
