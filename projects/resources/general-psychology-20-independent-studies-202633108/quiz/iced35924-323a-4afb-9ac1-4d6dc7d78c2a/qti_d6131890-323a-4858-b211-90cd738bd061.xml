        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;p&gt;&lt;span&gt;Levi suffers from chronic tension headaches and is undergoing a treatment plan to help relieve his pain. During the session, muscle tension is monitored and the feedback he receives helps him to learn to voluntarily relax these muscles. What type of treatment is this?&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span&gt;&lt;img src="http://higheredbcs.wiley.com/legacy/college/carpenter/0470410175/app_quizzes/carpenter2e_appquiz_ch03_files/q18-1.png" alt="" width="252" height="217" /&gt;&lt;/span&gt;&lt;/p&gt;</mattext>
          </material>
          <response_lid ident="iacf604f6-3275-45e5-bd96-fd8f21e53c67" rcardinality="Single">
            <render_choice shuffle="Yes">
              <response_label ident="i3ee9d80c-5dc1-4446-ad4c-c0f5b1d16a81">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;biofeedback&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i98da6bdc-4243-4a00-97a2-a2bb7832235d">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;relaxation therapy &lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i6d6806d3-9fed-4ab4-acb0-092eea79f3aa">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;span&gt;the target behavior approach&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="ie662e70b-798c-478f-8191-42c8420e3ac0">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Cognitive behavioral therapy&lt;/p&gt;</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar minvalue="0" maxvalue="100" varname="SCORE" vartype="Decimal" />
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="iacf604f6-3275-45e5-bd96-fd8f21e53c67">i3ee9d80c-5dc1-4446-ad4c-c0f5b1d16a81</varequal>
