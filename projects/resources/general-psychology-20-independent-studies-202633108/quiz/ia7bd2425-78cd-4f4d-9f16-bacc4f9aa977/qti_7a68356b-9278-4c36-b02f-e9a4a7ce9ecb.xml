        <presentation>
          <material>
            <mattext texttype="text/html">&lt;p&gt;&lt;span&gt;Jill was trying to operantly condition her dog to roll over. Each time her dog rolled over she immediately said "good dog." However, the dog did not roll over on command. Which of the following may best explain why?&lt;/span&gt;&lt;/p&gt;</mattext>
          </material>
          <response_lid ident="ic7ad89b7-48da-4e7e-8ce7-8ac88e85e6de" rcardinality="Single">
            <render_choice shuffle="Yes">
              <response_label ident="ic5f71a43-20a7-488e-97c2-d3cac32e8436">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;br /&gt;&lt;span&gt;saying "good dog" was not reinforcing to her dog&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i6acaab4a-c5d3-460d-802f-9f5fa9d4e42c">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;span&gt;Jill should have delayed reinforcement&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i2e7f8581-c90f-4ce3-86b9-c359736cf0a4">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;span&gt;Jill used inconsistent reinforcement&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i776e20bc-d087-4a00-8041-61cc15b88686">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;the CS did not match the CR&lt;/p&gt;</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
