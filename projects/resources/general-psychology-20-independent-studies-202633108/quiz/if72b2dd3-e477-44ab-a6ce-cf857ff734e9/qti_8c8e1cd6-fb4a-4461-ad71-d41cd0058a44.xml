        <presentation>
          <material>
            <mattext texttype="text/html">&lt;p&gt;&lt;span&gt;John Watson argued that the goal of psychology is&lt;/span&gt;&lt;/p&gt;</mattext>
          </material>
          <response_lid ident="ieb0cd3cf-fcbb-40aa-8743-6a1ed746ee4e" rcardinality="Single">
            <render_choice shuffle="Yes">
              <response_label ident="i41c2b043-c119-4742-a876-a3f75444522f">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;span&gt;to study behavior objectively.&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i7ca3e42e-bb63-4425-b2e3-80f70ee58354">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;span&gt;to study behavior subjectively (through introspection)&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i2f8829c4-3660-4523-b7eb-7c1880f432ae">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;br /&gt;&lt;span&gt;to study sensation, perception, and imagery.&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i8defdef2-71ca-4f24-bb7a-1dfed43e0c1d">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;span&gt;to determine the drives that motivate behavior.&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
