                <material>
                  <mattext texttype="text/html">&lt;p&gt;projectile trauma&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i69dcc4ba-c40d-477b-90c5-c6c438f44dd5">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;blunt force trauma&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="ia52a244c-11c2-40e4-ad8c-0705e8cde86b">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;sharp force trauma&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i8b166d51-c2ad-4261-ba11-d7af36ee44a4">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;strangulation trauma&lt;/p&gt;</mattext>
