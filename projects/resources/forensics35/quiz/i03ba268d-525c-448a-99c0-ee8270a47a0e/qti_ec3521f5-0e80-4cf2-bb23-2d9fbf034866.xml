        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;p&gt;What did DNA testing of the skeletal remains confirm?&lt;/p&gt;</mattext>
          </material>
          <response_lid ident="i5b3d9830-de82-4af9-819c-fa8ff1868423" rcardinality="Single">
            <render_choice>
              <response_label ident="i738a4cc8-f4a4-4228-8882-ca50ca3fcbaa">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Two skeletons belonging to the Romanov family were missing.&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="idd5ba53f-0393-43e5-8798-67908fbba7cf">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Three skeletons were male and six skeletons were female.&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i38b68eba-98a0-4261-8ed1-350c58e306a0">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Nine skeletons suffered from multiple bullet and bayonet wounds.&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="ifd119051-9939-4c63-b4af-9e7a888ffa04">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Five skeletons were part of the same family and four skeletons were unrelated.&lt;/p&gt;</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar minvalue="0" maxvalue="100" varname="SCORE" vartype="Decimal" />
          </outcomes>
          <respcondition>
            <conditionvar>
              <varequal respident="i5b3d9830-de82-4af9-819c-fa8ff1868423">i738a4cc8-f4a4-4228-8882-ca50ca3fcbaa</varequal>
