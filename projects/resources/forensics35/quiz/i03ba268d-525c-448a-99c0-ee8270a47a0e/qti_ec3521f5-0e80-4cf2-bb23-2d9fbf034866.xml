        <presentation>
          <material>
            <mattext texttype="text/html">&lt;p&gt;The faces of the victims were damaged by rifle butts. The type of trauma that this would have caused to the skull of each victim is&lt;/p&gt;</mattext>
          </material>
          <response_lid ident="i77a22dde-e90f-4f28-87cd-a37cd231b8b1" rcardinality="Single">
