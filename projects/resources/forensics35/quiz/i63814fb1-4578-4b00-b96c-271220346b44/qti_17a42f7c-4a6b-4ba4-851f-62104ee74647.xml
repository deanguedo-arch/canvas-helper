            <render_choice shuffle="Yes">
              <response_label ident="i76df3bc0-f19f-4e70-9f6b-505b1e234918">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;1, 3, 5, and 6&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i95a6b82e-146a-4400-b1db-7945f08ed7f6">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;2, 3, 4, and 8&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="ibc5dca0e-fe30-441d-b61f-6f1f793125e5">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;1, 4, 6, and 7&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i0c8a91f7-3222-49e8-af70-7cf8de682920">
