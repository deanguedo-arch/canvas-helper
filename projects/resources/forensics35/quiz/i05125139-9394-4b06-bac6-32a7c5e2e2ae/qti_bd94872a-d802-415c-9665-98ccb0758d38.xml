        <presentation>
          <material>
            <mattext texttype="text/html">&lt;p&gt;How does a Conducted Energy Device (CED) immobilize a suspect?&lt;/p&gt;</mattext>
          </material>
          <response_lid ident="i594d1b6a-d21c-4cfc-8c2e-cdb350e0080c" rcardinality="Single">
            <render_choice shuffle="Yes">
              <response_label ident="i1f9d966f-af57-4cb1-b860-07ddbc887c01">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;It stops neuron activity in the brain.&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="ia43435c8-2e4b-4669-80cc-d3238b2de5eb">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;It reduces sensitivity of the skin.&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i8ba2add1-f7fd-4f96-af95-13937d3f242e">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;It disrupts superficial muscle function.&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i18a9155c-8330-4b79-8fbf-161377d1c58c">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;It prevents the uptake of oxygen in the lungs.&lt;/p&gt;</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar minvalue="0" maxvalue="100" varname="SCORE" vartype="Decimal" />
          </outcomes>
          <respcondition>
            <conditionvar>
              <varequal respident="i594d1b6a-d21c-4cfc-8c2e-cdb350e0080c">i1f9d966f-af57-4cb1-b860-07ddbc887c01</varequal>
