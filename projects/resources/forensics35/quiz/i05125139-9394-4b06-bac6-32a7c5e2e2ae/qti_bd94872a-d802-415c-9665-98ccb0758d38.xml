        <presentation>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Which of the following symptoms are experienced after being hit by a CED?&lt;/p&gt;</mattext>
          </material>
          <response_lid ident="ib7ae5c92-a057-4857-9657-299657e2263e" rcardinality="Single">
            <render_choice shuffle="Yes">
              <response_label ident="idc00f9e5-7022-41cd-899c-22b3cdf4b3ec">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Pain, paralysis, and disorientation&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="ic390be22-9f5f-4c9f-bcf1-b66efd1e75dd">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Anger, guilt, and low blood pressure&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i8dcc66be-e1a9-4841-bc37-8e725a827728">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Depression, tiredness, and loss of hearing&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="ie89a4523-218e-4650-a452-ba59ac857fb5">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Nausea, sadness, and temporary blindness&lt;/p&gt;</mattext>
