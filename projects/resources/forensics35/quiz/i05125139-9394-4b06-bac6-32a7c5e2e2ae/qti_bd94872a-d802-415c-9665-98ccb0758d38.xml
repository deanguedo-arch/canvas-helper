        <presentation>
          <material>
            <mattext texttype="text/html">&lt;p&gt;The CED targets a pair of body systems:&lt;/p&gt;</mattext>
          </material>
          <response_lid ident="i9827395b-ed08-44f7-869e-8219b7113fe0" rcardinality="Single">
            <render_choice shuffle="Yes">
              <response_label ident="id4ae9a56-80a1-44c4-acd0-8b77ae9eae65">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;nervous and muscular&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i316d60a9-7052-4192-9fce-f61f08202ace">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;respiratory and skeletal&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="idbfddc99-3135-4c47-a251-a0e32df0372e">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;digestive and immune&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="iad69afbf-3501-4924-8866-17a5a8781320">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;circulatory and sensory&lt;/p&gt;</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
