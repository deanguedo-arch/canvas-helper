        <presentation>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Geographic profiling analyzes the locations of a related series of crimes to determine the&lt;/p&gt;</mattext>
          </material>
          <response_lid ident="i7455735c-c552-4130-bf93-a28ff2c4bfb8" rcardinality="Single">
            <render_choice>
              <response_label ident="i12350666-9cfa-4ca7-9950-4d036411ded8">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;location that the offender will hit next&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i94dc8203-3235-4315-b2b6-b9c8fd28d79d">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;location that the offender hid his or her weapon&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="ic9496cc7-7775-404b-aa35-41415e796c05">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;most likely location of an offender's family or place of birth&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="ic77dc0d9-fb0a-4d25-a7fb-4b077a0c6797">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;most probable location of an offender's residence or place of work&lt;/p&gt;</mattext>
