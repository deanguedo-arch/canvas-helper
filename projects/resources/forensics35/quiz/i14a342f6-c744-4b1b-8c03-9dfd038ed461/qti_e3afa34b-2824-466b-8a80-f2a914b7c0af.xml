          <material>
            <mattext texttype="text/html">&lt;p&gt;Indicate which skeletal remains characteristics below are matches to a human:&lt;/p&gt;</mattext>
          </material>
          <response_lid ident="i660f983d-abc5-4ac8-a8f9-653235da9316" rcardinality="Multiple">
            <render_choice shuffle="Yes">
              <response_label ident="i6a8fd061-9325-45f7-92a1-7a8db00d5337">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Femurs have a substantially larger trochanter due to larger muscle attachment sites and because the joint is positioned more sideways.&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="ieb3268ac-8fd3-48f2-8fd4-287caddbef3a">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;The large upper arm bone (humerus) has a smaller tubercle on the upper region.&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="ia9fe0915-9186-45c1-a901-8c457a4d919e">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Have 12 pairs of ribs.&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i19863399-ae3c-4042-aca4-19f8a9b3fd5a">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;The large upper leg bone (femur) has a large, spherical head and a long neck.&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="icde90b0d-7d6d-409e-af2f-18d808ddc1a9">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Rib bones tend to be linear and/or straight.&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i8d9db2e5-b54b-4e88-9258-c8b66be6e78a">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;The large upper arm bone (humerus) has fewer, smaller projections extending from its upper part.&lt;/p&gt;</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
