      "exactSource": "function progress(){const completed=new Set(S.history.filter(x=>x.kind==='check').map(x=>x.checkId));let count=C.checks.filter(x=>completed.has(x.id)).length;const percent=Math.round(count/C.checks.length*100);$('[data-progress-count]').textContent=`${count} of ${C.checks.length} checks`;$('[data-progress-percent]').textContent=percent+'%';$('[data-progress-fill]').style.width=percent+'%';$('[data-progress-fraction]').textContent=`${count} / ${C.checks.length}`;$$('[data-lesson-completion]').forEach(el=>{let check=C.checks.find(q=>q.route===el.dataset.lessonCompletion);el.textContent=completed.has(check?.id)?'Check completed':'Check not completed';});}\n"
    },
