      "exactSource": "function save(next,message='Saved in this browser. Nothing has been sent to a teacher.'){\n if(blocked){status('Saving is paused. Another tab or a storage problem requires attention. Copy visible unsaved writing before reloading.',true);return false;}\n try{const raw=localStorage.getItem(KEY);const disk=raw?JSON.parse(raw):{revision:0};if(disk.revision!==S.revision){blocked=true;throw Error('Another tab changed this chapter. Copy visible unsaved writing, then reload.');}\n next.revision=S.revision+1;const rawNext=JSON.stringify(next);localStorage.setItem(KEY,rawNext);S=next;if(LMS)publishLms();status(LMS?'Work stored; waiting for Brightspace confirmation.':message);return true;\n }catch(e){blocked=true;if(LMS)SC.failCourseSave(e);status('NOT SAVED: '+e.message+' Copy visible writing before closing this tab.',true);return false;}\n}\nfunction publishLms(){SC.publishCourseState(S,C.checks.filter(c=>S.history.some(r=>r.kind==='check'&&r.checkId===c.id)).map(c=>c.id));}\nwindow.addEventListener('canvas-helper:scorm-status',e=>{if(LMS)status(e.detail.message,e.detail.error);});\nif(LMS&&!blocked){publishLms();SC.registerCourse({flush:async()=>{await window.biologyTextbookPractice?.flush();if(blocked)throw Error('Course saving is paused; keep this page open.');publishLms();}});}\nfunction change(fn,message){const next=clone(S);fn(next);return save(next,message);}\nwindow.addEventListener('storage',e=>{if(e.key===KEY){blocked=true;if(LMS)SC.failCourseSave(Error('Another tab changed this chapter. Copy unsaved writing before reloading.'));status('Another tab changed this chapter’s work. This tab will not overwrite it. Copy any visible unsaved writing, then reload.',true);}});\n"
    },
