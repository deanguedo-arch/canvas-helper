      "exactSource": " $('[data-work-notes]').innerHTML=Object.entries(S.notes).filter(([id,n])=>n.submitted).map(([id,n])=>`<article class=\"history-run\"><h3>${esc(C.notes.find(v=>v.id===id)?.title||id)}</h3><p class=\"written-record\">${esc(n.submitted)}</p>${n.draft.trim()!==n.submitted?'<p class=\"muted\">A newer draft exists in the activity. This is the last explicitly saved response.</p>':''}</article>`).join('')||'<p>No optional written responses collected.</p>';\n"
    },
