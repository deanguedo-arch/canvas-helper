      "exactSource": " if(b.dataset.saveNote){const id=b.dataset.saveNote,v=S.notes[id];if(!v?.draft.trim()||v.draft.length>5000){status('Enter a response of 1–5000 characters before collecting it.',true);return;}if(change(n=>{n.notes[id].submitted=v.draft.trim();n.notes[id].at=Date.now();},'Optional written response collected. Required progress is unchanged.')){$(`[data-note-status=\"${id}\"]`).textContent='Saved response collected. It has not been automatically graded.';renderWork();revisionActivities.render();}return;}\n"
