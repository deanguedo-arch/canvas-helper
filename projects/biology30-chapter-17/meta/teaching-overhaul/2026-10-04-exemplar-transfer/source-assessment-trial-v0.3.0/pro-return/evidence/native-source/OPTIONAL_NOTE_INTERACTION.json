      "exactSource": " if(el.matches('[data-note-input]')){const saved=change(n=>{let v=n.notes[el.dataset.noteInput]??={draft:'',submitted:null};v.draft=el.value;});const out=$(`[data-note-status=\"${el.dataset.noteInput}\"]`);if(out)out.textContent=saved?'Draft saved locally. Select Save response to collect it.':'NOT SAVED. Copy this draft before leaving.';}\n"
