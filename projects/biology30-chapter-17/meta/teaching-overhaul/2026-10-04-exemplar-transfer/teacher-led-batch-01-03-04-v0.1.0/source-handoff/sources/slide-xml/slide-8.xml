="393B3F"/></a:solidFill><a:latin typeface="Verdana"/><a:ea typeface="Verdana"/><a:cs typeface="Verdana"/><a:sym typeface="Verdana"/></a:rPr><a:t>n of traits. For example, having brown eyes or having blue eyes.</a:t></a:r><a:endParaRPr sz="1900"><a:solidFill><a:srgbClr val="393B3F"/></a:solidFill><a:latin typeface="Verdana"/><a:ea typeface="Verdana"/><a:cs typeface="Verdana"/><a:sym typeface="Verdana"/></a:endParaRPr></a:p><a:p><a:pPr indent="-349250" lvl="0" marL="457200" marR="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="100000"/></a:lnSpc><a:spcBef><a:spcPts val="1000"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClr><a:srgbClr val="393B3F"/></a:buClr><a:buSzPts val="1900"/><a:buFont typeface="Verdana"/><a:buChar char="➢"/></a:pPr><a:r><a:rPr b="1" lang="en-CA" sz="1900"><a:solidFill><a:srgbClr val="393B3F"/></a:solidFill><a:latin typeface="Verdana"/><a:ea typeface="Verdana"/><a:cs typeface="Verdana"/><a:sym typeface="Verdana"/></a:rPr><a:t>Genotype</a:t></a:r><a:r><a:rPr lang="en-CA" sz="1900"><a:solidFill><a:srgbClr val="393B3F"/></a:solidFill><a:latin typeface="Verdana"/><a:ea typeface="Verdana"/><a:cs typeface="Verdana"/><a:sym typeface="Verdana"/></a:rPr><a:t> on the other hand refers to the </a:t></a:r><a:r><a:rPr b="1" lang="en-CA" sz="1900"><a:solidFill><a:srgbClr val="393B3F"/></a:solidFill><a:latin typeface="Verdana"/><a:ea typeface="Verdana"/><a:cs typeface="Verdana"/><a:sym typeface="Verdana"/></a:rPr><a:t>combination of alleles</a:t></a:r><a:r><a:rPr lang="en-CA" sz="1900"><a:solidFill><a:srgbClr val="393B3F"/></a:solidFill><a:latin typeface="Verdana"/><a:ea typeface="Verdana"/><a:cs typeface="Verdana"/><a:sym typeface="Verdana"/></a:rPr><a:t> an individual has for a given trait. </a:t></a:r><a:endParaRPr sz="1900"><a:solidFill><a:srgbClr val="393B3F"/></a:solidFill><a:latin typeface="Verdana"/><a:ea typeface="Verdana"/><a:cs typeface="Verdana"/><a:sym typeface="Verdana"/></a:endParaRPr></a:p><a:p><a:pPr indent="-349250" lvl="0" marL="4572