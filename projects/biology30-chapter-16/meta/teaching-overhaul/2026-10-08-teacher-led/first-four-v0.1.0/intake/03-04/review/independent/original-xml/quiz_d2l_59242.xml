0)-454</fieldentry></qti_metadatafield><qti_metadatafield><fieldlabel>qmd_aihumanorigin</fieldlabel><fieldentry>HumanGenerated</fieldentry></qti_metadatafield></qtimetadata></itemmetadata><itemproc_extension><d2l_2p0:difficulty>1</d2l_2p0:difficulty><d2l_2p0:isbonus>no</d2l_2p0:isbonus><d2l_2p0:ismandatory>no</d2l_2p0:ismandatory></itemproc_extension><presentation><flow><material><mattext texttype="text/html">&lt;p class="MsoNormal" style="margin: 0cm 0cm 0cm 18pt; font-size: medium; font-family: 'Times New Roman', serif; color: #000000; font-style: normal; font-weight: normal; text-align: start; text-indent: -18pt;"&gt;&lt;span style="font-family: arial, helvetica, sans-serif; font-size: 14pt;"&gt;An extra chromosome, or a missing chromosome, can result in a serious and even lethal genetic disorder. How is it possible for females to carry two X chromosomes and males only one X chromosome?&lt;/span&gt;&lt;/p&gt;</mattext></material><response_extension><d2l_2p0:display_style>2</d2l_2p0:display_style><d2l_2p0:enumeration>6</d2l_2p0:enumeration><d2l_2p0:grading_type>0</d2l_2p0:grading_type></response_extension><response_lid ident="QUES_53684_85606_LID" rcardinality="Single"><render_choice shuffle="no"><flow_label class="Block"><response_label ident="QUES_53684_85606_A285349"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;&lt;span style="font-family: arial, helvetica, sans-serif; font-size: 14pt;"&gt;In males, the Y chromosome has the same genes as the found on the X chromosome.&lt;/span&gt;&lt;/p&gt;</mattext></material></flow_mat></response_label></flow_label><flow_label class="Block"><response_label ident="QUES_53684_85606_A285350"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;&lt;span style="font-family: arial, helvetica, sans-serif; font-size: 14pt;"&gt;In males, the X chromosome becomes inactive and forms a Barr body.&lt;/span&gt;&lt;/p&gt;</mattext></material></flow_mat></response_label></flow_label><flow_label class="Block"><response_label ident="QUES_53684_85606_A285351"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;&lt;span style="font-family: arial, helvetica, sans-serif; font-size: 14pt;"&gt;In females, the genes on the extra X chromosome compensate for the genes that would normally be found on the Y chromosome.&lt;/span&gt;&lt;/p&gt;</mattext></material></flow_mat></response_label></flow_label><flow_label class="Block"><response_label ident="QUES_53684_85606_A285352"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;&lt;span style="font-family: arial, helvetica, sans-serif; font-size: 14pt;"&gt;In females, one X chromosome becomes inactive and forms a Barr body.&lt;/span&gt;&lt;/p&gt;</mattext></material></flow_mat></response_label></flow_label></render_choice></response_lid></flow></presentation><resprocessing><respcondition title="Response Condition 1"><conditionvar><varequal respident="QUES_53684_85606_LID">QUES_53684_85606_A285349</varequal></conditionvar><setvar action="Set">0.000000000</setvar><displayfeedback feedbacktype="Response" linkrefid="QUES_53684_85606_IF285349" /></respcondition><respcondition title="Response Condition 2"><conditionvar><varequal respident="QUES_53684_85606_LID">QUES_53684_85606_A285350</varequal></conditionvar><setvar action="Set">0.000000000</setvar><displayfeedback feedbacktype="Response" linkrefid="QUES_53684_85606_IF285350" /></respcondition><respcondition title="Response Condition 3"><conditionvar><varequal respident="QUES_53684_85606_LID">QUES_53684_85606_A285351</varequal></conditionvar><setvar action="Set">0.000000000</setvar><displayfeedback feedbacktype="Response" linkrefid="QUES_53684_85606_IF285351" /></respcondition><respcondition title="Response Condition 4"><conditionvar><varequal respident="QUES_53684_85606_LID">QUES_53684_85606_A285352</varequal></conditionvar><setvar action="Set">100.000000000</setvar><displayfeedback feedbacktype="Response" linkrefid="QUES_53684_85606_IF285352" /></respcondition></resprocessing><itemfeed