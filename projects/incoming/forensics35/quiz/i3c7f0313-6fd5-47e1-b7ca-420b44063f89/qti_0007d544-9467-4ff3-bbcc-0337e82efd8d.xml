        <presentation>
          <material>
            <mattext texttype="text/html">&lt;p&gt;What causes the casing of an explosive device to burst and fragment?&lt;/p&gt;</mattext>
          </material>
          <response_lid ident="i045f9dca-1b76-4b56-9941-d1245555cfa8" rcardinality="Single">
            <render_choice>
              <response_label ident="ica824034-296b-4ee1-9ffb-82adadd6a0d3">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;An increase in temperature outside the casing causes melting.&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i323f28a0-9276-4538-8fdd-7ac77473277b">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;A build-up of gases inside the casing leads to an increase in pressure.&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i69e5c151-5c0a-406a-9517-e12accda76f7">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;A build up of shock waves inside the casing leads to an increase in friction.&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="ice829bea-37f0-450d-953b-ff641dbaa721">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;A decrease in pressure outside the casing causes shock waves to be generated.&lt;/p&gt;</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar minvalue="0" maxvalue="100" varname="SCORE" vartype="Decimal" />
          </outcomes>
          <respcondition>
