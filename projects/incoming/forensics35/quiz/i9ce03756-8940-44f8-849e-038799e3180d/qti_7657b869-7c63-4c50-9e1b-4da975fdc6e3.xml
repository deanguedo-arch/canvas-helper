        <presentation>
          <material>
            <mattext texttype="text/html">&lt;p&gt;In Case Study #3, what &lt;strong&gt;two&lt;/strong&gt; pieces of physical evidence suggested the victim could have been poisoned?&lt;/p&gt;</mattext>
          </material>
          <response_lid ident="i7bcda5e1-2b8e-4b3f-875f-6fb9ac1c72be" rcardinality="Single">
            <render_choice shuffle="Yes">
              <response_label ident="i3cf3d28f-caca-4c08-813b-6a88054a34ac">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Fingerprints and rigor mortis&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i5a37d658-ebaa-4bd6-9910-c18efad7881e">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Puncture wound and marijuana cigarettes&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i3c859bfc-c86e-4425-9d86-62282015bbee">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Used syringe and empty rat poison container&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="idd53ccf4-7db4-402b-ab81-1ebabadf875a">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Crack residue and empty prescription bottles&lt;/p&gt;</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
