        <presentation>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Which of the following symptoms are likely effects of marijuana upon the human body?&lt;/p&gt;</mattext>
          </material>
          <response_lid ident="ibda21526-4c88-4616-97fd-3dbb1039aa63" rcardinality="Single">
            <render_choice shuffle="Yes">
              <response_label ident="ib493625a-c80a-4012-9dbb-9dcc241b8c61">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Cardiac arrest and seizures&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="if0d01818-b73b-4e86-8ddf-64d8b4137f1e">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Anxiety and blood vessel damage&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i77653573-a1c0-4b6f-bb96-a6a345f1bfe3">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Impaired coordination, impaired vision, and lower sperm count&lt;/p&gt;</mattext>
