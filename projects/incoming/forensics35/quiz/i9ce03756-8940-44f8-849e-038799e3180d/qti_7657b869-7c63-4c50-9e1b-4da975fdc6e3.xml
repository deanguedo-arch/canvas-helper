          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Which of the following are possible causes of poisons and toxins? Select all that apply:&lt;/p&gt;</mattext>
          </material>
          <response_lid ident="i03e9aee8-17cf-45c5-a0f3-41185730d3a1" rcardinality="Multiple">
            <render_choice shuffle="Yes">
              <response_label ident="i24939f60-d647-4432-8a87-23193cd4bd8e">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;inhibit chemical reactions in the body&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="ic3c41bd8-f0ca-488b-ae79-31914e75db6c">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;organ damage&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i3fed6144-2c45-44fd-98de-e3576bbb4537">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;prevents oxygen from attaching to the hemoglobin molecules within lymphatic cells&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i6c1d69eb-e0c3-45aa-bed4-df79d356d2d0">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;decreased hydrogen peroxide production&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i59f4648b-527a-4ddf-82b4-57b32dba1da4">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;increase ATP production&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="ic58f6bd6-5ce7-4c05-b845-76b7a04773d5">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;muscle spasms&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i2e717b2c-4a1e-49c0-957a-8e7bd87d88c2">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;block amino acid receptors in the brain and spinal cord&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i3c15664e-afff-4389-99d9-73de4be011ef">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;birth defects&lt;/p&gt;</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
