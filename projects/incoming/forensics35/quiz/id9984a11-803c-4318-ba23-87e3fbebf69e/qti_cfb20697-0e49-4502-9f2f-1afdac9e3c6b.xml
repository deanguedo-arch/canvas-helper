              <response_label ident="id00e97ca-4733-448b-8fc5-ef5abda047b7">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Lower temperatures increase the speed of the reaction.&lt;/p&gt;</mattext>
                </material>
