        <presentation>
          <material>
            <mattext texttype="text/html">&lt;p&gt;What three things must be present to start a fire?&lt;/p&gt;</mattext>
          </material>
          <response_lid ident="id9c1f4f4-54a0-4078-a8e7-4704266dbfb4" rcardinality="Single">
            <render_choice>
              <response_label ident="if78bd6ee-b1f1-40bf-9672-dd96546a160a">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Fuel, oxidant, and a heat source&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i364662de-ce08-4f6e-83e9-e081900eb31a">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Air, nitrogen, and a hydrocarbon&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="ie602108b-48bb-4431-b71f-a1a3ece8d4b3">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&amp;#160;Oxygen, water, and an ignitable liquid&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="icaf75f7b-3ba0-4628-b5e0-019d1566cc44">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&amp;#160;Accelerant, energy, and carbon dioxide&lt;/p&gt;</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
