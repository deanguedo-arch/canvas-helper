              <response_label ident="i8b816018-e20d-4d1e-b17a-699a9650bbfc">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;assaults, armed robberies, and fraud&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="iad36c287-7587-43b8-a0f8-2e71d8354fef">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;attempted homicides, homicides, and suicides&lt;/p&gt;</mattext>
