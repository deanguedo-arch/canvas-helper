            <mattext texttype="text/html">&lt;p&gt;&lt;strong id="yui_3_17_2_1_1607449387575_167"&gt;&lt;big id="yui_3_17_2_1_1607449387575_166"&gt;Example Chromatogram of Various Barbiturates&lt;/big&gt;&lt;/strong&gt; &lt;br /&gt;&lt;img style="max-width: 100%;" title="" src="exchromatogram.jpg" alt="" width="391" height="293" data-d2l-editor-default-img-style="true" /&gt;&lt;/p&gt;
