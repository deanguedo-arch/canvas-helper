        <presentation>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Soft body armour, such as the bullet-resistant vest, prevents injury from a gunshot by&lt;/p&gt;</mattext>
          </material>
          <response_lid ident="i8cde1b7f-99f4-4f25-83be-86aa113b6610" rcardinality="Single">
            <render_choice shuffle="Yes">
              <response_label ident="ic75e8058-f000-46c7-a8fe-be5a54e49e18">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;causing the fired bullet to ricochet&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i08183ad2-b854-4e81-9096-0ef990183b83">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;decreasing the mass of the fired bullet&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="i2abd8081-68a5-4c62-8a8f-07fd088000a1">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;absorbing the impact of the fired bullet&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="iace4fee4-5b7d-42e7-b8c3-3b9a0f03973d">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;increasing the fired bullet&amp;rsquo;s kinetic energy&lt;/p&gt;</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
