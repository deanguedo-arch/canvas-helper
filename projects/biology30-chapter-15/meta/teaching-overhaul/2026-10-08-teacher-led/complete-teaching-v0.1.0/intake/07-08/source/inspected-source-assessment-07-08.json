    "id": "OBJ_2131126",
    "stem": "The prenatal period of development described above is another term for the",
    "stemHtml": "<p><img style=\"max-width: 100%;\" src=\"PastedImage_txbqju9o14bwu541lwodddxevjwob3ai002.png\" /></p>\n<p class=\"MsoNormal\" style=\"margin: 0cm; font-size: medium; font-family: 'Times New Roman', serif; color: #000000; font-style: normal; font-weight: normal; text-align: start;\"><span style=\"font-family: arial, helvetica, sans-serif; font-size: 14pt;\">The prenatal period of development described above is another term for the</span><span style=\"font-family: arial, helvetica, sans-serif; font-size: 14pt;\"></span></p>",
    "images": [
      "PastedImage_txbqju9o14bwu541lwodddxevjwob3ai002.png"
    ],
    "options": [
      {
        "id": "QUES_53332_84813_A282884",
        "html": "<p><span style=\"font-family: arial, helvetica, sans-serif; font-size: 14pt;\">zygote period of development.</span></p>",
        "text": "zygote period of development."
      },
      {
        "id": "QUES_53332_84813_A282885",
        "html": "<p><span style=\"font-family: arial, helvetica, sans-serif; font-size: 14pt;\">fetal period of development.</span></p>",
        "text": "fetal period of development."
      },
      {
        "id": "QUES_53332_84813_A282886",
        "html": "<p><span style=\"font-family: arial, helvetica, sans-serif; font-size: 14pt;\">embryonic period of development.</span></p>",
        "text": "embryonic period of development."
      },
      {
        "id": "QUES_53332_84813_A282887",
        "html": "<p><span style=\"font-family: arial, helvetica, sans-serif; font-size: 14pt;\">placental stage of development.</span></p>",
        "text": "placental stage of development."
      }
    ],
    "correctOptionIds": [
