l="accent1"/></a:buClr><a:buSzPts val="608"/><a:buFont typeface="Noto Sans Symbols"/><a:buNone/></a:pPr><a:r><a:t></a:t></a:r><a:endParaRPr b="0" i="0" sz="800" u="none" cap="none" strike="noStrike"><a:solidFill><a:srgbClr val="000000"/></a:solidFill><a:latin typeface="Average"/><a:ea typeface="Average"/><a:cs typeface="Average"/><a:sym typeface="Average"/></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" marR="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="100000"/></a:lnSpc><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClr><a:schemeClr val="accent1"/></a:buClr><a:buSzPts val="1672"/><a:buFont typeface="Noto Sans Symbols"/><a:buNone/></a:pPr><a:r><a:t></a:t></a:r><a:endParaRPr b="0" i="0" sz="2200" u="none" cap="none" strike="noStrike"><a:solidFill><a:srgbClr val="000000"/></a:solidFill><a:latin typeface="Average"/><a:ea typeface="Average"/><a:cs typeface="Average"/><a:sym typeface="Average"/></a:endParaRPr></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="424" name="Google Shape;424;p36"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="476675" y="1894125"/><a:ext cx="4865700" cy="2518200"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln><a:noFill/></a:ln></p:spPr><p:txBody><a:bodyPr anchorCtr="0" anchor="ctr" bIns="91425" lIns="91425" spcFirstLastPara="1" rIns="91425" wrap="square" tIns="91425"><a:noAutofit/></a:bodyPr><a:lstStyle/><a:p><a:pPr indent="-228600" lvl="0" marL="457200" marR="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="100000"/></a:lnSpc><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClr><a:schemeClr val="dk1"/></a:buClr><a:buSzPts val="1400"/><a:buFont typeface="Average"/><a:buAutoNum type="arabicPeriod"/></a:pPr><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Average"/><a:ea typeface="Average"/><a:cs typeface="Average"/><a:sym typeface="Average"/></a:rPr><a:t>If a strong enough impulse is received and the threshold potential is reached (approx. -55 mV), </a:t></a:r><a:r><a:rPr b="0" i="0" lang="en" sz="1400" u="none" cap="none" strike="noStrike"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Average"/><a:ea typeface="Average"/><a:cs typeface="Average"/><a:sym typeface="Average"/></a:rPr><a:t>sodium gates </a:t></a:r><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Average"/><a:ea typeface="Average"/><a:cs typeface="Average"/><a:sym typeface="Average"/></a:rPr><a:t>will </a:t></a:r><a:r><a:rPr b="0" i="0" lang="en" sz="1400" u="none" cap="none" strike="noStrike"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Average"/><a:ea typeface="Average"/><a:cs typeface="Average"/><a:sym typeface="Average"/></a:rPr><a:t>open, thus allowing Na+ to diffuse freely across the membrane.</a:t></a:r><a:endParaRPr/></a:p><a:p><a:pPr indent="-228600" lvl="0" marL="457200" marR="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="100000"/></a:lnSpc><a:spcBef><a:spcPts val="1480"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClr><a:schemeClr val="dk1"/></a:buClr><a:buSzPts val="1400"/><a:buFont typeface="Average"/><a:buAutoNum type="arabicPeriod"/></a:pPr><a:r><a:rPr b="0" i="0" lang="en" sz="1400" u="none" cap="none" strike="noStrike"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Average"/><a:ea typeface="Average"/><a:cs typeface="Average"/><a:sym typeface="Average"/></a:rPr><a:t>Na+ rushes into the cell (down their concentration gradient </a:t></a:r><a:r><a:rPr lang="en"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Average"/><a:ea typeface="Average"/><a:cs typeface="Average"/><a:sym typeface="Average"/></a:rPr><a:t>→ facilitated diffusion</a:t></a:r><a:r><a:rPr b="0" i="0" lang="en" sz="1400" u="none" cap="none" strike="noStrike"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Average"/><a:ea typeface="Average"/><a:cs typeface="Average"/><a:sym typeface="Average"/></a:rPr><a:t>), leading to a slight positive charge on the inside relative to the outside.</a:t></a:r><a:endParaRPr/></a:p><a:p><a:pPr indent="-228600" lvl="0" marL="457200" marR="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="100000"/></a:lnSpc><a:spcBef><a:spcPts val="1480"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClr><a:schemeClr val="dk1"/></a:buClr><a:buSzPts val="1400"/><a:buFont typeface="Average"/><a:buAutoNum type="arabicPeriod"/></a:pPr><a:r><a:rPr b="0" i="0" lang="en" sz="1400" u="none" cap="none" strike="noStrike"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Average"/><a:ea typeface="Average"/><a:cs typeface="Average"/><a:sym typeface="Average"/></a:rPr><a:t>This reverses the membrane potential from -70 mV to +40 mV; the membrane is now said to be </a:t></a:r><a:r><a:rPr b="0" i="1" lang="en" sz="1400" u="none" cap="none" strike="noStrike"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Average"/><a:ea typeface="Average"/><a:cs typeface="Average"/><a:sym typeface="Average"/></a:rPr><a:t>depolarized. </a:t></a:r><a:endParaRPr/></a:p><a:p><a:pPr indent="-228600" lvl="0" marL="457200" marR="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="100000"/></a:lnSpc><a:spcBef><a:spcPts val="1480"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClr><a:schemeClr val="dk1"/></a:buClr><a:buSzPts val="1400"/><a:buFont typeface="Average"/><a:buAutoNum type="arabicPeriod"/></a:pPr><a:r><a:rPr b="0" i="0" lang="en" sz="1400" u="none" cap="none" strike="noStrike"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Average"/><a:ea typeface="Average"/><a:cs typeface="Average"/><a:sym typeface="Average"/></a:rPr><a:t>Once Na+ reaches equilibrium, the membrane once again becomes impermeable to them, and the gates close. </a:t></a:r><a:endParaRPr/></a:p></p:txBody></p:sp><p:pic><p:nvPicPr><p:cNvPr id="425" name="Google Shape;425;p36"/><p:cNvPicPr preferRelativeResize="0"/><p:nvPr/></p:nvPicPr><p:blipFill rotWithShape="1"><a:blip r:embed="rId3"><a:alphaModFix/></a:blip><a:srcRect b="0" l="0" r="6977" t="18540"/><a:stretch/></p:blipFill><p:spPr><a:xfrm><a:off x="5750950" y="2300425"/><a:ext cx="2596975" cy="1705599"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln cap="flat" cmpd="sng" w="19050"><a:solidFill><a:srgbClr val="999999"/></a:solidFill><a:prstDash val="solid"/><a:round/><a:headEnd len="sm" w="sm" type="none"/><a:tailEnd len="sm" w="sm" type="none"/></a:ln></p:spPr></p:pic></p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>