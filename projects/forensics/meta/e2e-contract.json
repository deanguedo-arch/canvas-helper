{
  "$schema": "../../../e2e/project-e2e-contract.schema.json",
  "projectSlug": "forensics",
  "requiredTestIds": [
    "studio-shell",
    "course-studio-tab",
    "workspace-project-select",
    "project-root",
    "workspace-preview-frame"
  ],
  "modes": {
    "enabled": true,
    "toggleRoleName": "Show archive",
    "learnerIndicator": "Learner mode",
    "archiveIndicator": "Archive mode"
  },
  "navigation": {
    "enabled": false,
    "nextRoleName": "Next",
    "previousRoleName": "Previous",
    "nodeCounterPattern": "Node\\s+\\d+\\s+of\\s+\\d+"
  },
  "quiz": {
    "enabled": true,
    "moduleTitle": "2 Types of Evidence and Fingerprint Analysis",
    "lessonTitle": "Module 2 Assessment: Types of Evidence and Fingerprint Analysis",
    "progressPattern": "answered",
    "checkAnswerRoleName": "Check answer"
  },
  "fallbackPanel": {
    "enabled": false
  },
  "moduleAssignments": {
    "enabled": true,
    "moduleWithAssignments": "1 Introduction to Crime Scenes",
    "moduleWithoutAssignments": "Course Information"
  },
  "assertionProfiles": {
    "html-default": {
      "checks": ["renderer-html", "section-mode", "quick-checkpoints"]
    },
    "assignment-default": {
      "checks": ["renderer-assignment", "quick-checkpoints"]
    },
    "quiz-default": {
      "checks": ["renderer-quiz", "quiz-answer", "quiz-progress", "quiz-nav", "quiz-next-question", "quick-checkpoints"]
    },
    "pdf-default": {
      "checks": ["renderer-pdf"]
    }
  },
  "modulePassTargets": [
    {
      "moduleTitle": "Course Information",
      "itemTitle": "Course outline (MUST READ)",
      "assertionProfile": "pdf-default",
      "checks": ["node-nav", "node-counter"]
    },
    {
      "moduleTitle": "Course Information",
      "itemTitle": "How to Properly Cite Sources",
      "assertionProfile": "html-default"
    },
    {
      "moduleTitle": "1 Introduction to Crime Scenes",
      "itemTitle": "Introduction to Crime Scenes Assignment",
      "assertionProfile": "assignment-default"
    },
    {
      "moduleTitle": "2 Types of Evidence and Fingerprint Analysis",
      "itemTitle": "M2 Types of Evidence and Fingerprint Analysis Assessment",
      "assertionProfile": "quiz-default"
    },
    {
      "moduleTitle": "3 Trace Evidence",
      "itemTitle": "Trace Evidence Assignment",
      "assertionProfile": "assignment-default"
    },
    {
      "moduleTitle": "4 Body Fluid Evidence",
      "itemTitle": "Body Fluid Evidence",
      "assertionProfile": "html-default"
    },
    {
      "moduleTitle": "5 Forensic Detection of Impaired Driving",
      "itemTitle": "Impaired Driving Assignment",
      "assertionProfile": "assignment-default"
    },
    {
      "moduleTitle": "7 Forensic Genetics",
      "itemTitle": "Forensic Genetics",
      "assertionProfile": "html-default"
    },
    {
      "moduleTitle": "FINAL EXAM",
      "itemTitle": "Final Exam",
      "assertionProfile": "quiz-default"
    },
    {
      "moduleTitle": "Extra Credits",
      "itemTitle": "Student Centred Learning Self Reflection",
      "assertionProfile": "quiz-default"
    },
    {
      "moduleTitle": "Teacher Resources (KEEP HIDDEN)",
      "itemTitle": "Forensic Science 25 Answer Keys",
      "assertionProfile": "pdf-default",
      "mode": "archive"
    }
  ],
  "visibilityChecks": [
    {
      "moduleTitle": "Teacher Resources (KEEP HIDDEN)",
      "itemTitle": "Forensic Science 25 Answer Keys",
      "learnerVisible": false,
      "archiveVisible": true
    }
  ]
}
