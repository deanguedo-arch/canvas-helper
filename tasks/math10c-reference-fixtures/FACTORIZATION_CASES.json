        ]
      },
      "equivalent_forms": [
        "(2x - 3)^2",
        "(2x - 3)(2x - 3)"
      ],
      "misconception": "Answering (2x + 3)^2, missing that the middle term is negative.",
      "derivation": "First and last terms are squares (2x and 3) and 2(2x)(-3) = -12x matches, so 4x^2 - 12x + 9 = (2x - 3)^2. Check: (2x - 3)(2x - 3) = 4x^2 - 12x + 9.",
      "domain": {
        "coefficients": "integers",
        "factor_over": "integers"
      }
    },
    {
      "id": "FACT-MULTI-11",
      "category": "multi-step",
      "prompt": "Factor completely over the integers: 2x^3 - 8x^2 + 8x",
      "variable": "x",
      "polynomial": [
        2,
        -8,
        8,
        0
      ],
      "expected": {
        "content": 2,
        "factors": [
          [
            1,
            0
          ],
          [
            1,
            -2
          ],
          [
            1,
            -2
          ]
        ]
      },
      "equivalent_forms": [
        "2x(x - 2)^2",
        "2x(x - 2)(x - 2)"
      ],
      "misconception": "Stopping after the GCF step at 2x(x^2 - 4x + 4) without factoring the remaining perfect-square trinomial.",
      "derivation": "First remove the GCF 2x: 2x(x^2 - 4x + 4). Then x^2 - 4x + 4 = (x - 2)^2 since 2(x)(-2) = -4x. So 2x^3 - 8x^2 + 8x = 2x(x - 2)^2. Check: 2x(x - 2)(x - 2) = 2x^3 - 8x^2 + 8x.",
      "domain": {
        "coefficients": "integers",
        "factor_over": "integers"
      }
    },
    {
      "id": "FACT-MULTI-12",
      "category": "multi-step",
      "prompt": "Factor completely over the integers: 3x^2 - 12",
      "variable": "x",
      "polynomial": [
        3,
        0,
        -12
      ],
      "expected": {
        "content": 3,
        "factors": [
          [
            1,
            -2
          ],
          [
            1,
            2
          ]
        ]
      },
      "equivalent_forms": [
        "3(x - 2)(x + 2)",
        "3(x + 2)(x - 2)"
      ],
      "misconception": "Factoring as (3x - 6)(x + 2) without removing the GCF first, or stopping at 3(x^2 - 4).",
      "derivation": "First remove the GCF 3: 3(x^2 - 4). Then x^2 - 4 = (x - 2)(x + 2). So 3x^2 - 12 = 3(x - 2)(x + 2). Check: 3(x - 2)(x + 2) = 3x^2 - 12.",
      "domain": {
        "coefficients": "integers",
        "factor_over": "integers"
      }
    },
    {
      "id": "FACT-PRIME-13",
      "category": "prime-over-integers",
      "prompt": "Determine whether x^2 + x + 1 factors over the integers.",
      "variable": "x",
      "polynomial": [
        1,
        1,
        1
      ],
      "expected": {
        "prime_over_integers": true,
        "prime_argument": {
          "kind": "quadratic-discriminant",
          "discriminant": -3
        }
      },
      "equivalent_forms": [
        "prime over the integers",
        "irreducible over the integers (quadratic with negative discriminant)"
      ],
      "misconception": "Claiming (x + 1)(x + 1) = x^2 + x + 1, when it expands to x^2 + 2x + 1.",
      "derivation": "For x^2 + x + 1, the discriminant is 1^2 - 4(1)(1) = -3, which is negative, so there are no real (hence no integer) linear factors. Prime over the integers.",
      "domain": {
        "coefficients": "integers",
        "factor_over": "integers"
      }
    },
    {
      "id": "FACT-REPEAT-14",
      "category": "repeated-factor",
      "prompt": "Factor completely over the integers: x^3 - 3x^2 + 3x - 1",
      "variable": "x",
      "polynomial": [
        1,
        -3,
        3,
        -1
      ],
      "expected": {
        "content": 1,
        "factors": [
          [
            1,
            -1
          ],
          [
            1,
            -1
          ],
          [
            1,
            -1
          ]
        ]
      },
      "equivalent_forms": [
        "(x - 1)^3",
        "(x - 1)(x - 1)(x - 1)"
      ],
      "misconception": "Grouping as x^2(x - 3) + 3(x - 1) and stopping, missing the repeated root x = 1 of multiplicity 3.",
      "derivation": "x = 1 is a root (1 - 3 + 3 - 1 = 0); dividing out (x - 1) repeatedly gives (x - 1)^3. Check: (x - 1)(x - 1)(x - 1) = x^3 - 3x^2 + 3x - 1.",
      "domain": {
        "coefficients": "integers",
        "factor_over": "integers"
      }
    }
