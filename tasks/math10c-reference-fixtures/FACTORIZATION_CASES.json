      },
      "equivalent_forms": [
        "(x + 3)^2",
        "(x + 3)(x + 3)"
      ],
      "misconception": "Answering (x + 9)(x - 3) or similar pairs with product 9 but sum 6 ignored.",
      "derivation": "First and last terms are squares (x and 3) and 2(x)(3) = 6x matches the middle term, so x^2 + 6x + 9 = (x + 3)^2. Check: (x + 3)(x + 3) = x^2 + 6x + 9.",
      "domain": {
        "coefficients": "integers",
        "factor_over": "integers"
      }
    },
    {
      "id": "FACT-PSQ-10",
      "category": "perfect-square-trinomial",
      "prompt": "Factor completely over the integers: 4x^2 - 12x + 9",
      "variable": "x",
      "polynomial": [
        4,
        -12,
        9
      ],
      "expected": {
        "content": 1,
        "factors": [
