{
  "pack": "math10c-factorization-reference-v1",
  "subject": "factoring",
  "cases": [
    {
      "id": "FACT-GCF-01",
      "category": "gcf",
      "prompt": "Factor completely over the integers: 6x^2 + 9x",
      "variable": "x",
      "polynomial": [
        6,
        9,
        0
      ],
      "expected": {
        "content": 3,
        "factors": [
          [
            1,
            0
          ],
          [
            2,
            3
          ]
        ]
      },
      "equivalent_forms": [
        "3x(2x + 3)",
        "(3x)(2x + 3)"
      ],
      "misconception": "Factoring out only x and leaving 3x(2x + 9), missing the numeric GCF of 3.",
      "derivation": "GCF of 6x^2 and 9x is 3x; 6x^2 + 9x = 3x(2x + 3). Check: 3x(2x + 3) = 6x^2 + 9x.",
      "domain": {
        "coefficients": "integers",
        "factor_over": "integers"
      }
    },
    {
      "id": "FACT-GCF-NEG-02",
      "category": "gcf",
      "prompt": "Factor completely over the integers: -4x^2 - 8x",
      "variable": "x",
      "polynomial": [
        -4,
        -8,
        0
      ],
      "expected": {
        "content": -4,
        "factors": [
          [
            1,
            0
          ],
          [
            1,
            2
          ]
        ]
      },
      "equivalent_forms": [
        "-4x(x + 2)",
        "(-4x)(x + 2)"
      ],
      "misconception": "Factoring out +4x instead of -4x, giving 4x(-x - 2); equivalent in value but not the canonical negative-leading-term form.",
      "derivation": "Both terms share -4x with a negative leading term: -4x^2 - 8x = -4x(x + 2). Check: -4x(x + 2) = -4x^2 - 8x.",
      "domain": {
        "coefficients": "integers",
        "factor_over": "integers"
      }
    },
    {
      "id": "FACT-DOS-03",
      "category": "difference-of-squares",
      "prompt": "Factor completely over the integers: x^2 - 49",
      "variable": "x",
      "polynomial": [
        1,
        0,
        -49
      ],
      "expected": {
        "content": 1,
        "factors": [
          [
            1,
            -7
          ],
          [
            1,
            7
          ]
        ]
      },
      "equivalent_forms": [
        "(x - 7)(x + 7)",
        "(x + 7)(x - 7)"
      ],
      "misconception": "Writing (x - 7)^2, confusing difference of squares with a perfect-square trinomial.",
      "derivation": "Both terms are squares: x^2 - 49 = (x)^2 - (7)^2 = (x - 7)(x + 7). Check: (x - 7)(x + 7) = x^2 - 49.",
      "domain": {
        "coefficients": "integers",
        "factor_over": "integers"
      }
    },
    {
      "id": "FACT-DOS-04",
      "category": "difference-of-squares",
      "prompt": "Factor completely over the integers: 9x^2 - 25",
      "variable": "x",
      "polynomial": [
        9,
        0,
        -25
      ],
      "expected": {
        "content": 1,
        "factors": [
          [
            3,
            -5
          ],
          [
            3,
            5
          ]
        ]
      },
      "equivalent_forms": [
        "(3x - 5)(3x + 5)",
        "(3x + 5)(3x - 5)"
      ],
      "misconception": "Writing (3x - 5)^2, or trying (9x - 5)(x + 5), which expands to 9x^2 + 40x - 25.",
      "derivation": "9x^2 = (3x)^2 and 25 = 5^2, so 9x^2 - 25 = (3x - 5)(3x + 5). Check: (3x - 5)(3x + 5) = 9x^2 - 25.",
      "domain": {
        "coefficients": "integers",
        "factor_over": "integers"
      }
    },
    {
      "id": "FACT-MONIC-05",
      "category": "monic-trinomial",
      "prompt": "Factor completely over the integers: x^2 + 5x + 6",
      "variable": "x",
      "polynomial": [
        1,
        5,
        6
      ],
      "expected": {
        "content": 1,
        "factors": [
          [
            1,
            2
          ],
          [
            1,
            3
          ]
        ]
      },
      "equivalent_forms": [
        "(x + 2)(x + 3)",
        "(x + 3)(x + 2)"
      ],
      "misconception": "Choosing 1 and 6 (sum 7, not 5) and answering (x + 1)(x + 6).",
      "derivation": "Need integers with product 6 and sum 5: 2 and 3. So x^2 + 5x + 6 = (x + 2)(x + 3). Check: (x + 2)(x + 3) = x^2 + 5x + 6.",
      "domain": {
        "coefficients": "integers",
        "factor_over": "integers"
      }
    },
    {
      "id": "FACT-MONIC-06",
      "category": "monic-trinomial",
      "prompt": "Factor completely over the integers: x^2 - 3x - 10",
      "variable": "x",
      "polynomial": [
        1,
        -3,
        -10
      ],
      "expected": {
        "content": 1,
        "factors": [
          [
            1,
            -5
          ],
          [
            1,
            2
          ]
        ]
      },
      "equivalent_forms": [
        "(x - 5)(x + 2)",
        "(x + 2)(x - 5)"
      ],
      "misconception": "Using +5 and -2 (sum +3) and answering (x + 5)(x - 2), flipping the sign of the middle term.",
      "derivation": "Need integers with product -10 and sum -3: -5 and 2. So x^2 - 3x - 10 = (x - 5)(x + 2). Check: (x - 5)(x + 2) = x^2 - 3x - 10.",
      "domain": {
        "coefficients": "integers",
        "factor_over": "integers"
      }
    },
    {
      "id": "FACT-NONMONIC-07",
      "category": "non-monic-trinomial",
      "prompt": "Factor completely over the integers: 2x^2 + 7x + 3",
      "variable": "x",
      "polynomial": [
        2,
        7,
        3
      ],
      "expected": {
        "content": 1,
        "factors": [
          [
            2,
            1
          ],
          [
            1,
            3
          ]
        ]
      },
      "equivalent_forms": [
        "(2x + 1)(x + 3)",
        "(x + 3)(2x + 1)"
      ],
      "misconception": "Answering (2x + 3)(x + 1), which expands to 2x^2 + 5x + 3 with the wrong middle term.",
      "derivation": "ac = 6; integers with product 6 and sum 7 are 1 and 6. Split: 2x^2 + x + 6x + 3 = x(2x + 1) + 3(2x + 1) = (2x + 1)(x + 3). Check: (2x + 1)(x + 3) = 2x^2 + 7x + 3.",
      "domain": {
        "coefficients": "integers",
        "factor_over": "integers"
      }
    },
    {
      "id": "FACT-NONMONIC-08",
      "category": "non-monic-trinomial",
      "prompt": "Factor completely over the integers: 3x^2 - 10x + 8",
      "variable": "x",
      "polynomial": [
        3,
        -10,
        8
      ],
      "expected": {
        "content": 1,
        "factors": [
