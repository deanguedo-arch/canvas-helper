          ]
        ]
      },
      "equivalent_forms": [
        "(3x - 4)(x - 2)",
        "(x - 2)(3x - 4)"
      ],
      "misconception": "Answering (3x - 8)(x - 1), which expands to 3x^2 - 11x + 8 with the wrong middle term.",
      "derivation": "ac = 24; integers with product 24 and sum -10 are -4 and -6. Split: 3x^2 - 4x - 6x + 8 = x(3x - 4) - 2(3x - 4) = (3x - 4)(x - 2). Check: (3x - 4)(x - 2) = 3x^2 - 10x + 8.",
      "domain": {
        "coefficients": "integers",
        "factor_over": "integers"
      }
    },
    {
      "id": "FACT-PSQ-09",
      "category": "perfect-square-trinomial",
      "prompt": "Factor completely over the integers: x^2 + 6x + 9",
      "variable": "x",
      "polynomial": [
        1,
        6,
        9
      ],
      "expected": {
        "content": 1,
        "factors": [
          [
