                  </div>
                  <div className="flex gap-4 w-full md:w-auto font-mono text-sm uppercase tracking-widest font-bold">
                    <button onClick={handleEdit} className="flex-1 md:flex-none flex items-center justify-center gap-2 bg-white text-slate-900 border-2 border-slate-900 px-6 py-3 shadow-[4px_4px_0px_rgba(30,41,59,1)] hover:bg-slate-50 active:translate-x-1 active:translate-y-1 active:shadow-none transition-all">
                      <Edit3 size={16} /> Edit Data
                    </button>
                    <button onClick={handlePrint} className="flex-1 md:flex-none flex items-center justify-center gap-2 bg-slate-900 text-white border-2 border-slate-900 px-6 py-3 shadow-[4px_4px_0px_rgba(148,163,184,1)] hover:bg-slate-800 active:translate-x-1 active:translate-y-1 active:shadow-none transition-all">
                      <Printer size={16} /> Print
                    </button>
                  </div>
                </div>
              </div>

              {/* Tally Cards */}
              <div className="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16 print-hide">
                <div className="border-4 border-slate-900 p-6 bg-white shadow-[6px_6px_0px_rgba(30,41,59,1)]">
                  <p className="font-mono text-sm font-bold uppercase tracking-widest text-slate-500 border-b-2 border-slate-900 pb-2 mb-4">Auto-Graded Section</p>
                  <div className="flex items-baseline gap-3 text-slate-900">
                    <span className="text-6xl font-black">{score}</span>
                    <span className="text-2xl font-bold text-slate-400">/ 8 MARKS</span>
                  </div>
                  <p className="font-serif italic text-lg mt-2 font-bold text-slate-700">Part 1 Score</p>
                </div>
                <div className="border-4 border-slate-900 p-6 bg-slate-100 shadow-[6px_6px_0px_rgba(30,41,59,1)]">
                   <p className="font-mono text-sm font-bold uppercase tracking-widest text-slate-500 border-b-2 border-slate-900 pb-2 mb-4">Manual Grading Reqd.</p>
                  <div className="flex items-baseline gap-3 text-slate-900">
                    <span className="text-6xl font-black">23</span>
                    <span className="text-2xl font-bold text-slate-400">MARKS</span>
                  </div>
                  <p className="font-serif italic text-lg mt-2 font-bold text-slate-700">Parts 2 & 3 Pending Review</p>
                </div>
              </div>

              {/* Evaluated Part 1 */}
              <section className="mb-20 print:mb-10">
                <div className="flex items-end justify-between border-b-4 border-slate-900 pb-2 mb-8">
                  <h3 className="font-mono text-2xl font-bold uppercase tracking-widest text-slate-900">Part 1 Evaluation</h3>
                  <span className="font-mono text-sm font-bold text-slate-500 print-hide">Score: {score}/8</span>
                </div>

                <div className="space-y-8">
                  {MCQ_DATA.map((q) => {
                    const userAnsIdx = responses[`mcq_${q.id}`];
                    const isCorrect = userAnsIdx === q.correctAnswer;
                    const hasAnswered = userAnsIdx !== undefined;

                    return (
                      <div key={q.id} className="print-break-inside-avoid">
                        <p className="font-serif text-xl font-bold text-slate-900 mb-4 flex gap-3">
                          <span className="font-mono">{q.id}.</span>
                          <span>{q.text}</span>
                        </p>
                        
                        <div className="ml-8">
                          {!hasAnswered ? (
                            <div className="inline-flex items-center gap-3 bg-red-50 border-2 border-red-900 text-red-900 px-4 py-3 font-mono font-bold uppercase tracking-widest text-sm shadow-[4px_4px_0px_rgba(127,29,29,1)] print-shadow-none">
                              <XSquare size={18} /> No Data Recorded
                            </div>
                          ) : (
                            <div className="space-y-4">
                              <div className={`flex items-start gap-4 p-4 border-2 ${isCorrect ? 'bg-[#f0fdf4] border-emerald-900 text-emerald-900 shadow-[4px_4px_0px_rgba(6,78,59,1)] print-border-none print-shadow-none print-text-black' : 'bg-red-50 border-red-900 text-red-900 shadow-[4px_4px_0px_rgba(127,29,29,1)] print-border-none print-shadow-none print-text-black'}`}>
                                {isCorrect ? <CheckSquare className="mt-1 flex-shrink-0" size={24} /> : <XSquare className="mt-1 flex-shrink-0" size={24} />}
                                <div>
                                  <span className="font-mono text-xs font-bold uppercase tracking-widest block mb-1 opacity-75">Recorded Answer</span>
                                  <span className="font-serif text-lg font-bold">{q.options[userAnsIdx]}</span>
                                </div>
                              </div>
                              
                              {!isCorrect && (
                                <div className="flex items-start gap-4 p-4 border-2 border-slate-900 bg-white text-slate-900 shadow-[4px_4px_0px_rgba(30,41,59,1)] print-border-none print-shadow-none">
                                  <CheckSquare className="mt-1 flex-shrink-0" size={24} />
                                  <div>
                                    <span className="font-mono text-xs font-bold uppercase tracking-widest block mb-1 opacity-75">Correct Answer Key</span>
                                    <span className="font-serif text-lg font-bold">{q.options[q.correctAnswer]}</span>
                                  </div>
                                </div>
                              )}
                            </div>
                          )}
                        </div>
                      </div>
                    );
                  })}
                </div>
              </section>

              {/* Evaluated Part 2 */}
              <section className="mb-20 print:mb-10">
                <div className="flex items-end justify-between border-b-4 border-slate-900 pb-2 mb-8">
                  <h3 className="font-mono text-2xl font-bold uppercase tracking-widest text-slate-900">Part 2 Responses</h3>
                  <span className="font-mono text-sm font-bold text-slate-500 uppercase tracking-widest print-hide">Awaiting Grading</span>
                </div>

                <div className="space-y-12">
                  {WRITTEN_DATA.map((q, idx) => {
                    const ans = responses[q.id];
                    return (
                      <div key={q.id} className="print-break-inside-avoid">
                        <div className="mb-4 flex gap-3 font-serif text-xl font-bold text-slate-900">
                          <span className="font-mono">{idx + 1}.</span>
                          <div className="flex-1">
                            <p className="leading-relaxed">{q.text}</p>
                            <span className="font-mono text-xs font-bold text-slate-500 uppercase tracking-widest mt-2 block">Value: {q.marks} Marks</span>
                          </div>
                        </div>
                        
                        <div className="ml-8 border-l-4 border-slate-900 pl-6 py-2 bg-slate-50 print:bg-transparent print:border-slate-400">
                          {ans ? (
                            <p className="font-serif text-lg leading-relaxed text-slate-800 whitespace-pre-wrap">{ans}</p>
                          ) : (
                            <p className="font-mono text-sm font-bold uppercase tracking-widest text-red-900 flex items-center gap-2">
                                <AlertCircle size={16} /> [Blank Entry]
                            </p>
                          )}
                        </div>
                      </div>
                    );
                  })}
                </div>
              </section>

              {/* Evaluated Part 3 */}
              <section className="mb-12 print:mb-0">
                <div className="flex items-end justify-between border-b-4 border-slate-900 pb-2 mb-8">
                  <h3 className="font-mono text-2xl font-bold uppercase tracking-widest text-slate-900">Part 3 Procedure</h3>
                  <span className="font-mono text-sm font-bold text-slate-500 uppercase tracking-widest print-hide">Awaiting Grading</span>
                </div>

                <div className="print-break-inside-avoid">
                  <p className="font-serif text-xl font-bold text-slate-900 mb-4">
                    Design a procedure to replicate the strawberry/chocolate yogurt experiment:
                    <span className="font-mono text-xs font-bold text-slate-500 uppercase tracking-widest block mt-2">Value: 10 Marks</span>
                  </p>
                  
                  <div className="ml-8 border-l-4 border-slate-900 pl-6 py-4 bg-slate-50 print:bg-transparent print:border-slate-400">
                    {responses['procedure'] ? (
                      <p className="font-mono text-base leading-relaxed text-slate-800 whitespace-pre-wrap">{responses['procedure']}</p>
                    ) : (
                      <p className="font-mono text-sm font-bold uppercase tracking-widest text-red-900 flex items-center gap-2">
                          <AlertCircle size={16} /> [No Procedure Logged]
                      </p>
                    )}
                  </div>
                </div>
              </section>

              {/* Reset Actions */}
              <div className="pt-12 mt-12 border-t-4 border-slate-900 flex justify-center print-hide">
                <button
                  onClick={handleReset}
                  className="flex items-center justify-center gap-2 font-mono text-sm font-bold uppercase tracking-widest text-slate-600 hover:text-red-900 hover:bg-red-50 border-2 border-transparent hover:border-red-900 px-6 py-3 transition-all"
                >
                  <RotateCcw size={16} /> Initialize New Session
                </button>
              </div>

            </div>
          )}

        </div>
      </div>
    </div>
  );
}