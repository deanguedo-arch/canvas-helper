            <p class="font-serif text-sm text-slate-500 mt-4 italic">Downloads a stylized, non-editable PDF of your completed notebook.</p>
        </div>

    </div>

    <script>
        // MCQ Checking Function
        function checkMCQ(questionName, correctAnswer) {
            var radios = document.getElementsByName(questionName);
            var selectedValue = "";
            for (var i = 0; i < radios.length; i++) {
                if (radios[i].checked) {
                    selectedValue = radios[i].value;
                    break;
                }
            }
            
            var feedbackSpan = document.getElementById('feedback-' + questionName);
            feedbackSpan.className = "font-mono text-sm uppercase font-bold tracking-wider mt-2 block";
            
            if (selectedValue === correctAnswer) {
                feedbackSpan.innerHTML = "[ VERIFIED: Correct ]";
                feedbackSpan.classList.add("text-emerald-700");
                feedbackSpan.classList.remove("text-rose-600");
            } else {
                feedbackSpan.innerHTML = "[ ERR: Incorrect ]";
                feedbackSpan.classList.add("text-rose-600");
                feedbackSpan.classList.remove("text-emerald-700");
            }
        }

        // Hint Toggle Function
        function toggleHint(hintId) {
            var x = document.getElementById(hintId);
            if (x.classList.contains("hidden")) {
                x.classList.remove("hidden");
            } else {
                x.classList.add("hidden");
            }
        }

        // Math Checking Functions
        function checkMath(elementId, correctAnswer) {
            var inputField = document.getElementById(elementId);
            var studentAnswer = parseFloat(inputField.value);
            if (studentAnswer === correctAnswer) {
                inputField.style.borderColor = "#047857"; 
                inputField.style.backgroundColor = "#d1fae5"; 
            } else {
                inputField.style.borderColor = "#1e293b"; 
                inputField.style.backgroundColor = "#f8fafc"; 
            }
        }

        function checkMultiple(elementId, correctAnswersArray) {
            var inputField = document.getElementById(elementId);
            var studentAnswer = parseFloat(inputField.value);
            if (correctAnswersArray.includes(studentAnswer)) {
                inputField.style.borderColor = "#047857"; 
                inputField.style.backgroundColor = "#d1fae5"; 
            } else {
                inputField.style.borderColor = "#1e293b"; 
                inputField.style.backgroundColor = "#f8fafc"; 
            }
        }

        // Stylized PDF Generation
        function generatePDF() {
            // 1. Force all textareas to their full height so content isn't cut off in the PDF snapshot
            const textareas = document.querySelectorAll('textarea.auto-expand');
            textareas.forEach(ta => {
                ta.style.height = 'auto';
                ta.style.height = ta.scrollHeight + 'px';
            });

            // 2. Temporarily hide "interactive only" UI elements (hints, the generate button itself)
            const interactiveElements = document.querySelectorAll('.interactive-only');
            interactiveElements.forEach(el => el.style.display = 'none');

            // 3. Setup PDF configuration (Letter size paper, slightly scaled up for crispness)
            const element = document.getElementById('paper-container');
            const opt = {
                margin:       0.2, // Small margin to accommodate the hard shadows
                filename:     'Psychology_Lab_Notebook_Completed.pdf',
                image:        { type: 'jpeg', quality: 1.0 },
                html2canvas:  { scale: 2, useCORS: true, windowWidth: 1024 }, // Desktop width to maintain layout
                jsPDF:        { unit: 'in', format: 'letter', orientation: 'portrait' }
            };

            // 4. Generate and download
            html2pdf().set(opt).from(element).save().then(() => {
                // Restore interactive elements after generating
                interactiveElements.forEach(el => el.style.display = '');
            });
        }
    </script>
</body>
</html>