                            <span class="font-mono text-[10px] uppercase tracking-widest text-emerald-800">Pop: 1.61 / Sam: 1.7</span>
                        </div>
                        <div class="flex items-center">
                            <input type="number" step="0.01" id="ansSD" onkeyup="checkMultiple('ansSD', [1.61, 1.7, 1.70])" class="bg-[#f8fafc] border-2 border-slate-800 p-2 font-mono text-center w-20 text-slate-900 focus:outline-none focus:bg-white rounded-none transition-colors mr-2">
