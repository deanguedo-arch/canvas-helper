                        </div>
                        <div class="flex items-center">
                            <input type="number" step="0.1" id="ansMean" onkeyup="checkMath('ansMean', 9)" class="bg-[#f8fafc] border-2 border-slate-800 p-2 font-mono text-center w-20 text-slate-900 focus:outline-none focus:bg-white rounded-none transition-colors mr-2">
                            <span class="font-mono text-xs text-slate-500">cm</span>
