        <!-- Institutional Details (Watermark & Tab) -->
        <div class="watermark absolute top-[30%] -right-32 rotate-90 opacity-5 font-mono text-8xl text-slate-900 font-bold select-none pointer-events-none tracking-tighter">
            FORM EP-30
        </div>
        <div class="interactive-only absolute top-0 right-8 bg-slate-800 text-white font-mono text-xs uppercase px-4 py-1 tracking-widest rounded-b-sm shadow-[2px_2px_0px_rgba(100,116,139,0.5)]">
