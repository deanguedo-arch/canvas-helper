                        <div class="flex items-center">
                            <input type="number" id="ansMode" onkeyup="checkMath('ansMode', 8)" class="bg-[#f8fafc] border-2 border-slate-800 p-2 font-mono text-center w-20 text-slate-900 focus:outline-none focus:bg-white rounded-none transition-colors mr-2">
                            <span class="font-mono text-xs text-slate-500">cm</span>
                        </div>
                    </div>

                    <div class="flex items-center justify-between border-b border-emerald-200 pb-3">
                        <div>
                            <span class="block font-bold text-slate-900">2. Median:</span>
                            <span class="font-mono text-[10px] uppercase tracking-widest text-emerald-800">Middle value</span>
                        </div>
                        <div class="flex items-center">
                            <input type="number" step="0.1" id="ansMedian" onkeyup="checkMath('ansMedian', 8.5)" class="bg-[#f8fafc] border-2 border-slate-800 p-2 font-mono text-center w-20 text-slate-900 focus:outline-none focus:bg-white rounded-none transition-colors mr-2">
                            <span class="font-mono text-xs text-slate-500">cm</span>
