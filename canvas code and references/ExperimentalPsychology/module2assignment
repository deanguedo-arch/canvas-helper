                    <div class="flex items-center justify-between border-b border-emerald-200 pb-3">
                        <div>
                            <span class="block font-bold text-slate-900">4. Range:</span>
                            <span class="font-mono text-[10px] uppercase tracking-widest text-emerald-800">High minus low</span>
                        </div>
                        <div class="flex items-center">
