                            {/* DONE Checkbox */}
                            <div className="w-20 flex justify-center">
                              <button 
                                onClick={() => toggleCourse(key, course, 'done')}
                                className={`w-6 h-6 rounded border flex items-center justify-center transition-all ${
                                  data.courses[key].done.includes(course) 
                                    ? 'bg-emerald-500/20 border-emerald-500 text-emerald-400' 
                                    : 'border-slate-600 hover:border-slate-400 text-transparent'
                                }`}
                              >
                                <Check className="w-4 h-4" />
                              </button>
                            </div>

                            {/* NEED Checkbox */}
                            <div className="w-20 flex justify-center">
                              <button 
                                onClick={() => toggleCourse(key, course, 'need')}
                                className={`w-6 h-6 rounded border flex items-center justify-center transition-all ${
                                  data.courses[key].need.includes(course) 
                                    ? 'bg-amber-500/20 border-amber-500 text-amber-400' 
                                    : 'border-slate-600 hover:border-slate-400 text-transparent'
                                }`}
                              >
                                <Check className="w-4 h-4" />
                              </button>
                            </div>
                          </div>
                        ))}
                      </div>
                    </GlassPanel>
                  ))}
                </div>
              </div>
            )}
          </div>
        </main>
      </div>


      {/* ------------------------------------------------------------- */}
      {/* PRINT-ONLY UI (HIDDEN ON SCREEN)                              */}
      {/* ------------------------------------------------------------- */}
      <div className="hidden print:block bg-white text-black min-h-screen">
        <PrintLayout data={data} />
      </div>

    </div>
  );
}

