<!DOCTYPE html>
<html class="scroll-smooth" lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Interactive Simulator - Validity Gates</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    
    <style>
        .material-symbols-outlined {
            font-family: 'Material Symbols Outlined';
            font-weight: normal;
            font-style: normal;
            font-size: 24px;
            line-height: 1;
            letter-spacing: normal;
            text-transform: none;
            display: inline-block;
            white-space: nowrap;
            word-wrap: normal;
            direction: ltr;
            -webkit-font-feature-settings: 'liga';
            -webkit-font-smoothing: antialiased;
        }

        :root {
            /* Light Mode Color Palette (Matches Scale Game) */
            --color-surface: 255 255 255;
            --color-on-surface: 15 23 42;
            --color-on-surface-variant: 71 85 105;
            --color-surface-container-lowest: 255 255 255;
            --color-surface-container-low: 248 250 252;
            --color-surface-container: 241 245 249;
            --color-surface-container-high: 226 232 240;
            --color-surface-container-highest: 203 213 225;
            --color-surface-variant: 226 232 240;
            --color-outline: 148 163 184;
            --color-outline-variant: 203 213 225;
            
            --color-primary: 37 99 235;
            --color-on-primary-container: 30 58 138;
            --color-secondary: 13 148 136;
            --color-tertiary: 217 119 6;
            --color-error: 220 38 38;
        }

        .dark {
            /* Dark Mode Color Palette */
            --color-surface: 12 19 36;
            --color-on-surface: 220 225 251;
            --color-on-surface-variant: 194 198 214;
            --color-surface-container-lowest: 7 13 31;
            --color-surface-container-low: 21 27 45;
            --color-surface-container: 25 31 49;
            --color-surface-container-highest: 46 52 71;
            --color-surface-variant: 46 52 71;
            --color-outline: 140 144 159;
            --color-outline-variant: 66 71 84;
            
            --color-primary: 173 198 255;
            --color-on-primary-container: 0 40 93;
            --color-secondary: 79 219 200;
            --color-tertiary: 255 185 95;
            --color-error: 255 180 171;
        }

        /* Animations */
        @keyframes popIn {
            0% { transform: scale(0.95); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }
        .animate-popIn {
            animation: popIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }
    </style>
    
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "surface": "rgb(var(--color-surface) / <alpha-value>)",
                        "on-surface": "rgb(var(--color-on-surface) / <alpha-value>)",
                        "on-surface-variant": "rgb(var(--color-on-surface-variant) / <alpha-value>)",
                        "surface-container-lowest": "rgb(var(--color-surface-container-lowest) / <alpha-value>)",
                        "surface-container-low": "rgb(var(--color-surface-container-low) / <alpha-value>)",
                        "surface-container": "rgb(var(--color-surface-container) / <alpha-value>)",
                        "surface-container-highest": "rgb(var(--color-surface-container-highest) / <alpha-value>)",
                        "surface-variant": "rgb(var(--color-surface-variant) / <alpha-value>)",
                        "outline": "rgb(var(--color-outline) / <alpha-value>)",
                        "outline-variant": "rgb(var(--color-outline-variant) / <alpha-value>)",
                        "primary": "rgb(var(--color-primary) / <alpha-value>)",
                        "on-primary-container": "rgb(var(--color-on-primary-container) / <alpha-value>)",
                        "secondary": "rgb(var(--color-secondary) / <alpha-value>)",
                        "tertiary": "rgb(var(--color-tertiary) / <alpha-value>)",
                        "error": "rgb(var(--color-error) / <alpha-value>)"
                    },
                    fontFamily: {
                        "body": ["Inter", "sans-serif"],
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-surface text-on-surface font-body p-4 md:p-8 min-h-screen">

    <div class="max-w-[1440px] mx-auto w-full">
        <!-- Header -->
        <div class="flex flex-col items-center text-center gap-4 mb-8">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary w-max font-bold text-sm tracking-widest uppercase">
                <span class="material-symbols-outlined text-[18px]">rule_folder</span>
                Interactive Training Simulator
            </div>
            <h2 class="text-[36px] text-on-surface font-bold">Establishing Validity Gates</h2>
            <p class="text-lg text-on-surface-variant max-w-3xl">Navigate real-world scenarios to practice applying the assessment integrity workflow. Evaluate the evidence, conduct the defense, and validate learning.</p>
        </div>

        <!-- The Simulator Container -->
        <div class="bg-surface-container-lowest rounded-3xl border border-surface-variant shadow-inner flex flex-col relative overflow-hidden min-h-[500px]">
            <!-- Background grid styling -->
            <div class="absolute inset-0 pointer-events-none opacity-[0.03] dark:opacity-10" style="background-image: linear-gradient(to right, rgb(var(--color-outline)) 1px, transparent 1px), linear-gradient(to bottom, rgb(var(--color-outline)) 1px, transparent 1px); background-size: 40px 40px;"></div>
            
            <!-- Progress Bar Header -->
            <div id="progress-header" class="relative z-10 bg-surface-container-low px-6 py-4 border-b border-surface-variant flex justify-between items-center text-sm font-bold text-on-surface-variant">
                <span id="scenario-counter">Scenario 1 of 2</span>
                <span id="scenario-subject" class="flex items-center gap-2 text-primary">
                    <span class="material-symbols-outlined text-[18px]">menu_book</span> Grade 10 Science (Alex)
                </span>
            </div>

            <!-- Flowchart Visualizer -->
            <div id="flowchart-container" class="relative z-10 w-full px-6 pt-8 pb-4 overflow-x-auto">
                <!-- Dynamically populated by JS -->
            </div>

            <!-- Main Interaction Area -->
            <div id="game-content" class="relative z-10 p-6 md:p-10 flex-grow flex flex-col justify-center items-center w-full">
                <!-- Dynamically populated by JS -->
            </div>
        </div>
    </div>

    <script>
        // --- Scenario Data ---
        const SCENARIOS = [
            {
                id: 1,
                student: "Alex",
                subject: "Grade 10 Science",
                assignment: "Climate Change Research Paper",
                observation: "Alex submitted a paper that uses highly advanced, post-graduate level vocabulary regarding atmospheric chemistry.",
                defenseResult: "fail",
                defenseText: "During the mandatory defense, you ask Alex to explain the concept of 'anthropogenic radiative forcing' which is heavily featured in his paper. Alex stammers, looks at the floor, and says, 'Uh, it means... when radiation forces the climate to change... by humans?' He is unable to elaborate further or connect it to the rest of his paper.",
            },
            {
                id: 2,
                student: "Maya",
                subject: "Grade 12 Computer Science",
                assignment: "Python Data Sorting Algorithm",
                observation: "Maya submitted a highly optimized, complex sorting algorithm that goes far beyond what was taught in the base curriculum.",
                defenseResult: "pass",
                defenseText: "During the mandatory defense, you ask Maya to whiteboard the logic of the algorithm and explain why she chose it over the standard bubble sort. Maya confidently breaks down the code line-by-line, explains Big O notation (which she researched independently), and even points out a minor flaw she'd fix if she had more time.",
            }
        ];

        // --- State Management ---
        let currentScenarioIndex = 0;
        let step = 'start'; 
        // steps: 'start' -> 'review' -> 'defense' -> 'decision' -> ('validated' | 'not_validated') -> ('redo' | 'accept_mark') -> 'end'
        let score = { correct: 0, total: 0 };

        function setStep(newStep) {
            step = newStep;
            render();
        }

        function handleDecision(decision) {
            const scenario = SCENARIOS[currentScenarioIndex];
            const isCorrect = decision === scenario.defenseResult;
            
            score.total += 1;
            if (isCorrect) score.correct += 1;
            
            if (decision === 'pass') {
                setStep('validated');
            } else {
                setStep('not_validated');
            }
        }

        function handleNextScenario() {
            if (currentScenarioIndex < SCENARIOS.length - 1) {
                currentScenarioIndex++;
                setStep('start');
            } else {
                setStep('end');
            }
        }

        function restartSimulation() {
            currentScenarioIndex = 0;
            score = { correct: 0, total: 0 };
            setStep('start');
        }

        // --- Flowchart Visualizer Logic ---
        function getStatusClass(targetSteps) {
            if (targetSteps.includes(step)) {
                return "bg-primary text-on-primary shadow-md border-primary transform scale-[1.02] opacity-100";
            }
            return "bg-surface text-on-surface-variant border-outline-variant opacity-60";
        }

        function renderFlowchart() {
            const container = document.getElementById('flowchart-container');
            const header = document.getElementById('progress-header');
            
            if (step === 'end') {
                container.innerHTML = '';
                header.style.display = 'none';
                return;
            }

            header.style.display = 'flex';
            document.getElementById('scenario-counter').innerText = `Scenario ${currentScenarioIndex + 1} of ${SCENARIOS.length}`;
            document.getElementById('scenario-subject').innerHTML = `<span class="material-symbols-outlined text-[18px]">menu_book</span> ${SCENARIOS[currentScenarioIndex].subject} (${SCENARIOS[currentScenarioIndex].student})`;

            container.innerHTML = `
                <div class="hidden md:flex items-start justify-center w-full space-x-2 text-xs font-bold text-center">
                    <div class="p-3 rounded-lg border-2 transition-all duration-300 w-32 ${getStatusClass(['review'])}">
                        Teacher Review
                    </div>
                    <span class="material-symbols-outlined mt-3 text-outline-variant flex-shrink-0">arrow_forward</span>
                    
                    <div class="p-3 rounded-lg border-2 transition-all duration-300 w-32 ${getStatusClass(['defense'])}">
                        Conduct Defense
                    </div>
                    <span class="material-symbols-outlined mt-3 text-outline-variant flex-shrink-0">arrow_forward</span>
                    
                    <div class="p-3 rounded-full border-2 transition-all duration-300 w-36 flex items-center justify-center ${getStatusClass(['decision'])}">
                        Defends Result?
                    </div>
                    
                    <!-- Branching -->
                    <div class="flex flex-col space-y-4 ml-2">
                        <div class="flex items-center space-x-2">
                            <div class="text-outline-variant font-bold mb-4 mt-2 text-[10px]">YES &rarr;</div>
                            <div class="p-3 rounded-lg border-2 transition-all duration-300 w-32 ${getStatusClass(['validated'])}">
                                VALIDATED
                            </div>
                        </div>
                        <div class="flex items-start space-x-2">
                            <div class="text-outline-variant font-bold mt-2 text-[10px]">NO &rarr;</div>
                            <div class="flex flex-col space-y-2">
                                <div class="p-3 rounded-lg border-2 transition-all duration-300 w-48 ${getStatusClass(['not_validated', 'redo', 'accept_mark'])}">
                                    NOT VALIDATED
                                </div>
                                <div class="flex space-x-2">
                                    <div class="p-2 rounded-lg border-2 text-[10px] transition-all duration-300 w-24 ${getStatusClass(['redo'])}">
                                        Redo
                                    </div>
                                    <div class="p-2 rounded-lg border-2 text-[10px] transition-all duration-300 w-24 ${getStatusClass(['accept_mark'])}">
                                        Accept Mark
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }

        // --- Content Render Logic ---
        function renderContent() {
            const contentDiv = document.getElementById('game-content');
            const scenario = SCENARIOS[currentScenarioIndex];
            
            let html = '';

            if (step === 'start') {
                html = `
                    <div class="text-center max-w-2xl mx-auto w-full animate-popIn">
                        <div class="w-16 h-16 bg-primary/10 text-primary rounded-full flex items-center justify-center mx-auto mb-6 border border-primary/20">
                            <span class="material-symbols-outlined text-[32px]">inventory_2</span>
                        </div>
                        <h2 class="text-3xl font-bold text-on-surface mb-4">Assessment Submitted</h2>
                        <p class="text-lg text-on-surface-variant mb-8">
                            The student has submitted their product and process evidence. It is time to prepare for their mandatory oral defense.
                        </p>
                        <div class="bg-surface p-6 rounded-xl text-left border border-outline-variant mb-8 shadow-sm">
                            <p class="font-bold text-on-surface mb-2 uppercase text-xs tracking-widest">Initial Observation:</p>
                            <p class="text-on-surface-variant italic text-lg leading-relaxed">"${scenario.observation}"</p>
                        </div>
                        <button onclick="setStep('review')" class="bg-primary hover:bg-primary/90 text-on-primary font-bold py-3 px-8 rounded-xl shadow-md transition-all flex items-center gap-2 mx-auto active:scale-95">
                            <span class="material-symbols-outlined">assignment</span> Begin Teacher Review
                        </button>
                    </div>
                `;
            } 
            
            else if (step === 'review') {
                html = `
                    <div class="max-w-2xl mx-auto w-full animate-popIn">
                        <div class="flex items-center gap-4 mb-6 border-b border-surface-variant pb-4">
                            <div class="bg-primary/10 text-primary p-3 rounded-xl border border-primary/20">
                                <span class="material-symbols-outlined text-[28px]">assignment</span>
                            </div>
                            <div>
                                <h2 class="text-2xl font-bold text-on-surface">Teacher Review of Evidence</h2>
                                <p class="text-primary font-bold text-sm uppercase tracking-wide">Pre-Conference Analysis</p>
                            </div>
                        </div>
                        
                        <p class="text-lg text-on-surface-variant mb-6 leading-relaxed">
                            Based on your review of the <strong>${scenario.assignment}</strong>, you have formulated specific probes to verify the student's understanding and ownership of the material during their defense.
                        </p>
                        <div class="bg-secondary/10 p-5 rounded-xl border border-secondary/30 mb-8 flex items-start gap-3">
                            <span class="material-symbols-outlined text-secondary mt-0.5">mic</span>
                            <p class="text-on-surface text-sm">
                                <strong>Action Required:</strong> Conduct the mandatory oral defense with ${scenario.student} to evaluate their actual understanding of the submitted work.
                            </p>
                        </div>

                        <div class="flex justify-end">
                            <button onclick="setStep('defense')" class="bg-secondary hover:bg-secondary/90 text-on-secondary font-bold py-3 px-6 rounded-xl shadow-md transition-all flex items-center gap-2 active:scale-95">
                                Conduct Oral Defense <span class="material-symbols-outlined">arrow_forward</span>
                            </button>
                        </div>
                    </div>
                `;
            } 
            
            else if (step === 'defense') {
                html = `
                    <div class="max-w-3xl mx-auto w-full animate-popIn">
                        <div class="flex items-center gap-4 mb-6 border-b border-surface-variant pb-4">
                            <div class="bg-secondary/10 text-secondary p-3 rounded-xl border border-secondary/20">
                                <span class="material-symbols-outlined text-[28px]">forum</span>
                            </div>
                            <h2 class="text-2xl font-bold text-on-surface">Conduct Oral Defense / Skill Check</h2>
                        </div>
                        
                        <div class="bg-surface border border-outline-variant p-8 rounded-2xl mb-8 relative shadow-sm">
                            <div class="absolute -top-3 left-6 bg-surface-container-lowest px-2 text-xs font-bold text-outline uppercase tracking-wider">Simulation Transcript</div>
                            <p class="text-lg text-on-surface-variant leading-relaxed italic">
                                ${scenario.defenseText}
                            </p>
                        </div>

                        <div class="text-center mt-8 pt-8 border-t border-surface-variant">
                            <h3 class="text-xl font-bold text-on-surface mb-6">Decision Gate: Did the student accurately defend the result?</h3>
                            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                                <button onclick="handleDecision('pass')" class="flex-1 bg-surface border border-outline-variant hover:border-secondary hover:bg-secondary/5 text-secondary font-bold py-6 px-6 rounded-2xl transition-all shadow-sm flex flex-col items-center gap-3 group active:scale-95">
                                    <span class="material-symbols-outlined text-[40px] text-outline-variant group-hover:text-secondary transition-colors">check_circle</span>
                                    YES, accurate defense
                                </button>
                                <button onclick="handleDecision('fail')" class="flex-1 bg-surface border border-outline-variant hover:border-error hover:bg-error/5 text-error font-bold py-6 px-6 rounded-2xl transition-all shadow-sm flex flex-col items-center gap-3 group active:scale-95">
                                    <span class="material-symbols-outlined text-[40px] text-outline-variant group-hover:text-error transition-colors">cancel</span>
                                    NO, weak process/assessment
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            } 
            
            else if (step === 'validated') {
                html = `
                    <div class="text-center max-w-2xl mx-auto w-full animate-popIn">
                        <div class="w-24 h-24 bg-secondary/10 border-4 border-secondary text-secondary rounded-full flex items-center justify-center mx-auto mb-6 shadow-[0_0_30px_rgba(13,148,136,0.3)]">
                            <span class="material-symbols-outlined text-[48px]">verified</span>
                        </div>
                        <h2 class="text-4xl font-bold text-on-surface mb-2 uppercase tracking-tight">Result Validated</h2>
                        
                        <div class="bg-surface-container border border-outline-variant p-8 rounded-2xl my-8 text-left shadow-sm">
                            <h3 class="font-bold text-on-surface mb-4 text-lg">Required Next Steps:</h3>
                            <ul class="space-y-4">
                                <li class="flex items-center gap-4 text-on-surface-variant">
                                    <div class="w-8 h-8 bg-outline-variant/30 rounded-lg flex items-center justify-center text-on-surface font-bold text-sm border border-outline-variant/50">1</div>
                                    Apply Full Marks/Grading
                                </li>
                                <li class="flex items-center gap-4 text-on-surface-variant">
                                    <div class="w-8 h-8 bg-outline-variant/30 rounded-lg flex items-center justify-center text-on-surface font-bold text-sm border border-outline-variant/50">2</div>
                                    Provide Constructive Feedback
                                </li>
                            </ul>
                        </div>

                        <button onclick="handleNextScenario()" class="bg-surface-variant hover:bg-outline text-on-surface font-bold py-4 px-8 rounded-xl shadow-md transition-all active:scale-95 border border-outline-variant">
                            Continue to Next Case
                        </button>
                    </div>
                `;
            } 
            
            else if (step === 'not_validated') {
                html = `
                    <div class="max-w-2xl mx-auto w-full text-center animate-popIn">
                        <div class="w-24 h-24 bg-error/10 border-4 border-error text-error rounded-full flex items-center justify-center mx-auto mb-6 shadow-[0_0_30px_rgba(220,38,38,0.3)]">
                            <span class="material-symbols-outlined text-[48px]">cancel</span>
                        </div>
                        <h2 class="text-4xl font-bold text-on-surface mb-4 uppercase tracking-tight">Not Validated</h2>
                        <p class="text-on-surface-variant text-lg font-medium mb-8">The student could not accurately defend their work.</p>

                        <div class="bg-surface border border-outline-variant rounded-2xl p-8 shadow-sm">
                            <h3 class="text-lg font-bold text-on-surface mb-6">Select the appropriate next action based on policy:</h3>
                            
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <button onclick="setStep('redo')" class="bg-surface-container-lowest border border-outline-variant hover:border-primary hover:bg-primary/5 text-on-surface font-bold py-6 px-4 rounded-xl transition-all shadow-sm flex flex-col items-center gap-3 group">
                                    <span class="material-symbols-outlined text-[36px] text-outline-variant group-hover:text-primary transition-colors">replay</span>
                                    Opportunity to redo
                                </button>
                                
                                <button onclick="setStep('accept_mark')" class="bg-surface-container-lowest border border-outline-variant hover:border-primary hover:bg-primary/5 text-on-surface font-bold py-6 px-4 rounded-xl transition-all shadow-sm flex flex-col items-center gap-3 group">
                                    <span class="material-symbols-outlined text-[36px] text-outline-variant group-hover:text-primary transition-colors">task_alt</span>
                                    Accept mark given
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            } 
            
            else if (step === 'redo' || step === 'accept_mark') {
                const icon = step === 'redo' ? 'replay' : 'task_alt';
                const title = step === 'redo' ? 'Opportunity to redo assessment' : 'Accept mark given';
                
                html = `
                    <div class="text-center max-w-2xl mx-auto w-full animate-popIn">
                        <div class="w-20 h-20 bg-primary/10 text-primary border-2 border-primary/30 rounded-full flex items-center justify-center mx-auto mb-6">
                            <span class="material-symbols-outlined text-[40px]">${icon}</span>
                        </div>
                        <h2 class="text-3xl font-bold text-on-surface mb-4">${title}</h2>
                        <p class="text-on-surface-variant text-lg mb-8 bg-surface border border-outline-variant p-6 rounded-2xl">
                            You have recorded this administrative decision for <strong>${scenario.student}</strong>. The validity gate process is now complete for this assignment.
                        </p>
                        <button onclick="handleNextScenario()" class="bg-surface-variant hover:bg-outline text-on-surface font-bold py-4 px-8 rounded-xl shadow-md transition-all active:scale-95 border border-outline-variant">
                            Continue to Next Case
                        </button>
                    </div>
                `;
            } 
            
            else if (step === 'end') {
                html = `
                    <div class="text-center max-w-2xl mx-auto w-full animate-popIn py-8">
                        <div class="w-32 h-32 bg-secondary/10 text-secondary border-4 border-secondary/50 rounded-full flex items-center justify-center mx-auto mb-6 shadow-xl">
                            <span class="material-symbols-outlined text-[64px]">verified_user</span>
                        </div>
                        <h2 class="text-5xl font-black text-on-surface mb-4 tracking-tighter">Simulation Complete</h2>
                        <p class="text-xl text-on-surface-variant mb-12">
                            You successfully navigated the Establishing Validity Gates protocol.
                        </p>
                        
                        <div class="grid grid-cols-2 gap-4 max-w-md mx-auto mb-12 text-left">
                            <div class="bg-surface p-4 rounded-xl border border-outline-variant shadow-sm flex flex-col items-center">
                                <span class="text-4xl font-bold text-on-surface">${score.total}</span>
                                <span class="text-sm text-on-surface-variant uppercase tracking-wider font-bold mt-1">Total Scenarios</span>
                            </div>
                            <div class="bg-surface p-4 rounded-xl border border-outline-variant shadow-sm flex flex-col items-center">
                                <span class="text-4xl font-bold text-secondary">${score.correct}</span>
                                <span class="text-sm text-secondary uppercase tracking-wider font-bold mt-1">Correct Calls</span>
                            </div>
                        </div>

                        <button onclick="restartSimulation()" class="bg-primary hover:bg-primary/90 text-on-primary font-bold py-4 px-10 rounded-xl shadow-lg transition-all text-lg flex items-center gap-2 mx-auto active:scale-95">
                            <span class="material-symbols-outlined">restart_alt</span> Restart Simulation
                        </button>
                    </div>
                `;
            }

            contentDiv.innerHTML = html;
        }

        function render() {
            renderFlowchart();
            renderContent();
        }

        // Initialize
        render();

    </script>
</body>
</html>