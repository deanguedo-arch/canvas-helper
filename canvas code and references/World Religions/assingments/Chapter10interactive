import React, { useState } from 'react';
import { Search, Eye, Users, AlertTriangle, BookMarked, ChevronRight, Archive } from 'lucide-react';

// --- THE LIVING ARCHIVE: DESIGN TOKENS ---
const theme = {
  colors: {
    primary: '#775a19',
    primaryContainer: '#c5a059',
    surface: '#fdf9ef',
    surfaceLow: '#f7f3e9',
    surfaceHigh: '#f2eee4',
    surfaceDim: '#dddad0',
    surfaceLowest: '#ffffff',
    textMain: '#2d281f',
    textMuted: '#635b4c'
  },
  fonts: {
    serif: '"Noto Serif", serif',
    sans: '"Manrope", sans-serif'
  },
  easing: 'cubic-bezier(0.4, 0, 0.2, 1)'
};

export default function CanadianInterfaithArchive() {
  const [activeStep, setActiveStep] = useState(0);
  
  // Artifact State
  const [formData, setFormData] = useState({
    itemName: '',
    description: '',
    benefits: '',
    challenge: '',
    source1: '',
    source2: ''
  });

  const handleInputChange = (e) => {
    const { name, value } = e.target;
    setFormData(prev => ({ ...prev, [name]: value }));
  };

  const steps = [
    { id: 'identification', title: 'Example Identification', icon: Search, marks: 2 },
    { id: 'description', title: 'Detailed Description', icon: Eye, marks: 4 },
    { id: 'benefits', title: 'Benefits of Pluralism', icon: Users, marks: 4 },
    { id: 'challenge', title: 'Ongoing Challenge', icon: AlertTriangle, marks: 3 },
    { id: 'bibliography', title: 'Bibliography', icon: BookMarked, marks: 3 },
    { id: 'folio', title: 'The Final Folio', icon: Archive, marks: 16 }
  ];

  const nextStep = () => setActiveStep(prev => Math.min(prev + 1, steps.length - 1));
  const setStep = (idx) => setActiveStep(idx);

  return (
    <div 
      className="min-h-screen flex selection:bg-[#c5a059] selection:text-white"
      style={{ backgroundColor: theme.colors.surface, color: theme.colors.textMain, fontFamily: theme.fonts.sans }}
    >
      {/* Texture Overlay */}
      <div 
        className="fixed inset-0 pointer-events-none z-50 opacity-[0.03]"
        style={{ backgroundImage: `url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E")` }}
      />

      {/* Sidebar: The Archive Index */}
      <nav 
        className="w-64 lg:w-80 hidden md:flex flex-col relative z-20"
        style={{ backgroundColor: theme.colors.surfaceDim }}
      >
        <div className="p-8 pb-12">
          <h1 className="text-3xl leading-tight mt-6" style={{ fontFamily: theme.fonts.serif }}>
            Canadian Interfaith Example
          </h1>
          <p className="mt-4 text-sm" style={{ color: theme.colors.textMuted }}>
            Chapter 10 • Option A • 16 Marks
          </p>
        </div>

        <div className="flex-1 px-4 flex flex-col gap-2">
          {steps.map((step, idx) => {
            const isActive = activeStep === idx;
            const Icon = step.icon;
            return (
              <button
                key={step.id}
                onClick={() => setStep(idx)}
                className="w-full text-left py-3 px-4 flex items-center gap-4 relative group"
                style={{ transition: `all 500ms ${theme.easing}` }}
              >
                {isActive && (
                  <span 
                    className="absolute left-0 top-0 bottom-0 w-[3px]"
                    style={{ backgroundColor: theme.colors.primary }}
                  />
                )}
                <Icon 
                  size={18} 
                  style={{ color: isActive ? theme.colors.primary : theme.colors.textMuted }} 
                  className="group-hover:scale-110 transition-transform duration-500"
                />
                <span 
                  className="font-medium text-sm"
                  style={{ color: isActive ? theme.colors.textMain : theme.colors.textMuted }}
                >
                  {step.title}
                </span>
                {isActive && (
                  <span className="ml-auto text-[0.6875rem] uppercase tracking-widest" style={{ color: theme.colors.primary }}>
                    {step.marks} Pts
                  </span>
                )}
              </button>
            );
          })}
        </div>
      </nav>

      {/* Main Content: The Folio */}
      <main className="flex-1 flex flex-col relative z-10 overflow-y-auto">
        <div className="max-w-4xl w-full mx-auto p-6 md:p-12 lg:py-20 lg:px-24 flex-1 flex flex-col">
          
          <header className="mb-16">
            <span className="text-[0.6875rem] uppercase tracking-[0.1em]" style={{ color: theme.colors.primary }}>
              Chapter 10 • Option A
            </span>
            <h2 className="text-[2.5rem] md:text-[3.5rem] leading-[1.1] mt-4 mb-6" style={{ fontFamily: theme.fonts.serif }}>
              {steps[activeStep].title}
            </h2>
            {activeStep !== 5 && (
              <p className="text-lg italic" style={{ fontFamily: theme.fonts.serif, color: theme.colors.textMuted }}>
                Curator's Note: Record the details of your selected interfaith example with precision and scholarly objectivity.
              </p>
            )}
          </header>

          <div className="flex-1">
            {activeStep === 0 && <StepIdentification data={formData} onChange={handleInputChange} />}
            {activeStep === 1 && <StepDescription data={formData} onChange={handleInputChange} />}
            {activeStep === 2 && <StepBenefits data={formData} onChange={handleInputChange} />}
            {activeStep === 3 && <StepChallenge data={formData} onChange={handleInputChange} />}
            {activeStep === 4 && <StepBibliography data={formData} onChange={handleInputChange} />}
            {activeStep === 5 && <FinalFolio data={formData} />}
          </div>

          {/* Navigation Glass Footer */}
          {activeStep < 5 && (
            <div 
              className="mt-16 sticky bottom-6 p-4 rounded-xl flex justify-between items-center backdrop-blur-[20px]"
              style={{ backgroundColor: 'rgba(255, 255, 255, 0.8)', boxShadow: '0 0 32px rgba(119, 90, 25, 0.05)' }}
            >
              <span style={{ color: theme.colors.textMuted }} className="text-sm font-medium px-4">
                Step {activeStep + 1} of 5
              </span>
              <button
                onClick={nextStep}
                className="px-8 py-3 rounded-sm text-white font-medium flex items-center gap-2 group"
                style={{ 
                  background: `linear-gradient(to right, ${theme.colors.primary}, ${theme.colors.primaryContainer})`,
                  transition: `all 500ms ${theme.easing}`
                }}
              >
                Proceed
                <ChevronRight size={18} className="group-hover:translate-x-1 transition-transform" />
              </button>
            </div>
          )}
        </div>
      </main>

      <style dangerouslySetInnerHTML={{__html: `
        @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700&family=Noto+Serif:ital,wght@0,400;0,700;1,400&display=swap');
        
        .scholarly-input {
          width: 100%;
          background-color: ${theme.colors.surfaceLowest};
          color: ${theme.colors.textMain};
          padding: 1rem 1.25rem;
          border-radius: 0.125rem;
          outline: none;
          box-shadow: inset 0 0 0 1px rgba(0,0,0,0.08);
          transition: all 400ms ${theme.easing};
        }
        .scholarly-input:focus {
          box-shadow: inset 0 -2px 0 0 ${theme.colors.primary}, inset 0 0 0 1px rgba(0,0,0,0.05);
        }
        .scholarly-input::placeholder {
          color: rgba(0,0,0,0.3);
        }
        .motif-bg {
          background-image: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M50 5 L55 45 L95 50 L55 55 L50 95 L45 55 L5 50 L45 45 Z' fill='none' stroke='%23000' stroke-width='1' stroke-opacity='0.05'/%3E%3Ccircle cx='50' cy='50' r='20' fill='none' stroke='%23000' stroke-width='1' stroke-opacity='0.05'/%3E%3C/svg%3E");
          background-repeat: no-repeat;
          background-position: bottom -20px right -20px;
          background-size: 200px;
        }
      `}} />
    </div>
  );
}

// --- STEP COMPONENTS ---

function StepIdentification({ data, onChange }) {
  return (
    <div className="space-y-8 animate-in fade-in duration-700">
      <p style={{ color: theme.colors.textMain }} className="text-lg font-medium">
        Identify the Canadian interfaith or multi-faith example you selected.
      </p>
      <div className="space-y-2 max-w-xl">
        <label className="text-[0.6875rem] uppercase tracking-widest font-bold" style={{ color: theme.colors.primary }}>Example Name</label>
        <input 
          type="text" name="itemName" value={data.itemName} onChange={onChange}
          className="scholarly-input" placeholder="e.g., A local interfaith festival, a multicultural calendar project, a multi-faith community group..."
        />
      </div>
    </div>
  );
}

function StepDescription({ data, onChange }) {
  return (
    <div className="space-y-6 animate-in fade-in duration-700">
      <p style={{ color: theme.colors.textMain }} className="text-lg font-medium">
        Describe it in sufficient detail.
      </p>
      <div className="relative">
        <textarea 
          name="description" value={data.description} onChange={onChange}
          rows={10}
          className="scholarly-input resize-none" 
          placeholder="Begin your description here. Consider its history, who is involved, the activities that take place, and its role in the community..."
        />
        <Eye className="absolute right-4 bottom-4 opacity-10" size={48} />
      </div>
    </div>
  );
}

function StepBenefits({ data, onChange }) {
  return (
    <div className="space-y-6 animate-in fade-in duration-700">
      <p style={{ color: theme.colors.textMain }} className="text-lg font-medium">
        Explain which benefits of pluralism or dialogue are visible in your example.
      </p>
      <div className="relative">
        <textarea 
          name="benefits" value={data.benefits} onChange={onChange}
          rows={10}
          className="scholarly-input resize-none" 
          placeholder="Does it build understanding, reduce prejudice, foster civic trust, or encourage respectful exchange? Elaborate on how pluralism is actively demonstrated..."
        />
        <Users className="absolute right-4 bottom-4 opacity-10" size={48} />
      </div>
    </div>
  );
}

function StepChallenge({ data, onChange }) {
  return (
    <div className="space-y-6 animate-in fade-in duration-700">
      <p style={{ color: theme.colors.textMain }} className="text-lg font-medium">
        Describe one challenge the example may still face.
      </p>
      <div className="relative">
        <textarea 
          name="challenge" value={data.challenge} onChange={onChange}
          rows={8}
          className="scholarly-input resize-none" 
          placeholder="Reflect on ongoing tensions, misunderstandings, secularization, or practical challenges in maintaining interfaith dialogue..."
        />
        <AlertTriangle className="absolute right-4 bottom-4 opacity-10" size={48} />
      </div>
    </div>
  );
}

function StepBibliography({ data, onChange }) {
  return (
    <div className="space-y-8 animate-in fade-in duration-700">
      <p style={{ color: theme.colors.textMuted }} className="italic font-serif">
        Provide a bibliography of at least two sources using proper format (e.g., APA or MLA). 
      </p>
      
      <div className="space-y-4">
        <div className="relative">
          <span className="absolute left-4 top-4 font-serif italic text-black/30">1.</span>
          <textarea 
            name="source1" value={data.source1} onChange={onChange}
            rows={3} className="scholarly-input pl-10 resize-none" 
            placeholder="Citation..."
          />
        </div>
        <div className="relative">
          <span className="absolute left-4 top-4 font-serif italic text-black/30">2.</span>
          <textarea 
            name="source2" value={data.source2} onChange={onChange}
            rows={3} className="scholarly-input pl-10 resize-none" 
            placeholder="Citation..."
          />
        </div>
      </div>
    </div>
  );
}

function FinalFolio({ data }) {
  const isComplete = data.itemName && data.description && data.benefits && data.challenge;

  return (
    <div className="animate-in fade-in duration-1000">
      {!isComplete ? (
        <div className="p-8 text-center" style={{ backgroundColor: theme.colors.surfaceLow }}>
          <p className="font-serif italic" style={{ color: theme.colors.textMuted }}>
            The artifact record is incomplete. Please ensure you have filled out the key analytical fields before archiving the folio.
          </p>
        </div>
      ) : (
        <div 
          className="p-8 md:p-12 motif-bg relative overflow-hidden"
          style={{ backgroundColor: theme.colors.surfaceHigh, boxShadow: '0 10px 40px rgba(0,0,0,0.03)' }}
        >
          {/* Header */}
          <div className="border-b pb-8 mb-8" style={{ borderColor: 'rgba(0,0,0,0.05)' }}>
            <div className="flex items-center gap-3 mb-4">
              <span className="px-3 py-1 rounded-sm text-[0.625rem] uppercase tracking-widest font-bold text-white" style={{ backgroundColor: theme.colors.primary }}>
                Archived Study
              </span>
            </div>
            <h3 className="text-4xl font-serif mb-2" style={{ color: theme.colors.textMain }}>
              {data.itemName}
            </h3>
            <p className="text-lg" style={{ color: theme.colors.textMuted }}>Canadian Interfaith Example</p>
          </div>

          {/* Content Grid */}
          <div className="grid grid-cols-1 md:grid-cols-3 gap-12">
            <div className="md:col-span-2 space-y-10">
              <section>
                <h4 className="text-[0.6875rem] uppercase tracking-widest font-bold mb-3 flex items-center gap-2" style={{ color: theme.colors.primary }}>
                  <Eye size={16} /> Detailed Description
                </h4>
                <p className="leading-relaxed whitespace-pre-wrap" style={{ color: theme.colors.textMain }}>{data.description}</p>
              </section>

              <section>
                <h4 className="text-[0.6875rem] uppercase tracking-widest font-bold mb-3 flex items-center gap-2" style={{ color: theme.colors.primary }}>
                  <Users size={16} /> Benefits of Pluralism
                </h4>
                <p className="leading-relaxed whitespace-pre-wrap" style={{ color: theme.colors.textMain }}>{data.benefits}</p>
              </section>
            </div>

            <div className="space-y-8">
              <section className="p-6 rounded-sm" style={{ backgroundColor: theme.colors.surfaceLowest, boxShadow: 'inset 0 0 0 1px rgba(0,0,0,0.03)' }}>
                <h4 className="text-[0.6875rem] uppercase tracking-widest font-bold mb-3 flex items-center gap-2" style={{ color: theme.colors.primary }}>
                  <AlertTriangle size={16} /> Ongoing Challenge
                </h4>
                <p className="text-sm leading-relaxed" style={{ color: theme.colors.textMuted }}>{data.challenge}</p>
              </section>

              <section>
                <h4 className="text-[0.6875rem] uppercase tracking-widest font-bold mb-3" style={{ color: theme.colors.primary }}>Bibliography</h4>
                <ul className="space-y-3 text-sm" style={{ color: theme.colors.textMuted }}>
                  {data.source1 && <li className="pl-4 relative before:absolute before:left-0 before:top-2 before:w-1.5 before:h-[1px] before:bg-black/20">{data.source1}</li>}
                  {data.source2 && <li className="pl-4 relative before:absolute before:left-0 before:top-2 before:w-1.5 before:h-[1px] before:bg-black/20">{data.source2}</li>}
                </ul>
              </section>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}